(load "../carp-reader.carp")
(Project.no-echo)
(load "Test.carp")

(use-all Test Form)

(defn unsafe-parse [s] (Result.from-success (Reader.parse s) []))

(defn parse-error? [s] (Result.error? &(Reader.parse s)))

(defn first-form [s]
  (let [arr (unsafe-parse s)] @(Box.peek (Array.unsafe-nth &arr 0))))

(defn first-child-col [s]
  (let [loc (first-form s)]
    (match-ref (Located.form &loc)
      (Lst items)
        @(Info.col (Located.info (Box.peek (Array.unsafe-nth items 0))))
      _ -1)))

(defn str-bytes [src]
  (match (Reader.parse-form src)
    (Result.Success l)
      (match-ref (Located.form &l) (Str s) (String.to-bytes s) _ [])
    (Result.Error _) []))

(defn is-double? [s]
  (let [loc (first-form s)] (match-ref (Located.form &loc) (Dbl _) true _ false)))

(defn is-float? [s]
  (let [loc (first-form s)] (match-ref (Located.form &loc) (Flt _) true _ false)))

; a literal newline is the one control byte Form.str deliberately emits raw.
(defn printable-source? [s]
  (let-do [bs (String.to-bytes s)
           ok true]
    (for [i 0 (Array.length &bs)]
      (let [v (Byte.to-int @(Array.unsafe-nth &bs i))]
        (when (and (or (Int.< v 32) (Int.= v 127)) (Int./= v 10))
          (set! ok false))))
    ok))

(defn string-byte-round-trips? [b]
  (let [want (String.from-bytes &[(Byte.from-int b)])
        rendered (Form.str &(Form.Str (String.from-bytes &[(Byte.from-int b)])))]
    (and (printable-source? &rendered)
         (match (Reader.parse-form &rendered)
           (Result.Success l)
             (match-ref (Located.form &l) (Str s) (= s &want) _ false)
           (Result.Error _) false))))

(defn char-code-round-trips? [i]
  (let [rendered (Form.str &(Form.Chr (Char.from-int i)))]
    (and (printable-source? &rendered)
         (match (Reader.parse-form &rendered)
           (Result.Success l)
             (match-ref (Located.form &l)
               (Chr c) (Int.= (Char.to-int @c) i)
               _ false)
           (Result.Error _) false))))

(defn bad-string-bytes []
  (let-do [n 0]
    (for [b 1 256] (unless (string-byte-round-trips? b) (set! n (Int.inc n))))
    n))

(defn bad-char-codes []
  (let-do [n 0]
    (for [i 1 256] (unless (char-code-round-trips? i) (set! n (Int.inc n))))
    n))

(deftest t
  (assert-equal t 1 (Array.length &(unsafe-parse "42")) "parse: single integer")
  (assert-equal t "42" &(Located.str &(first-form "42")) "round-trip: integer")
  (assert-equal t "-7l" &(Located.str &(first-form "-7l")) "round-trip: long")
  (assert-equal t "255b" &(Located.str &(first-form "255b")) "round-trip: byte")
  (assert-equal t
    "1.5f"
    &(Located.str &(first-form "1.5f"))
    "round-trip: float with period")
  (assert-equal t
    "2f"
    &(Located.str &(first-form "2f"))
    "round-trip: float no period")
  (assert-equal t
    "3.14"
    &(Located.str &(first-form "3.14"))
    "round-trip: double")
  (assert-equal t "true" &(Located.str &(first-form "true")) "bool true")
  (assert-equal t "false" &(Located.str &(first-form "false")) "bool false")
  (assert-equal t
    "\"hello\""
    &(Located.str &(first-form "\"hello\""))
    "round-trip: string")
  (assert-equal t
    "\\space"
    &(Located.str &(first-form "\\space"))
    "round-trip: named char")
  (assert-equal t
    1
    (Array.length &(unsafe-parse "\\U0001f600"))
    "char above BMP parses as a single form")
  (assert-equal t
    "\\U0001f600"
    &(Located.str &(first-form "\\U0001f600"))
    "round-trip: char above BMP via \\U")
  (assert-equal t
    "\\U00010000"
    &(Located.str &(first-form "\\U00010000"))
    "round-trip: first astral codepoint via \\U")
  (assert-equal t
    "\\uffff"
    &(Located.str &(first-form "\\uffff"))
    "round-trip: U+FFFF stays \\u at the BMP boundary")
  (assert-equal t
    "Foo.Bar.baz"
    &(Located.str &(first-form "Foo.Bar.baz"))
    "round-trip: dotted symbol")
  (assert-equal t
    "+"
    &(Located.str &(first-form "+"))
    "round-trip: operator symbol")

  (assert-equal t
    "(defn foo [x] x)"
    &(Located.str &(first-form "(defn foo [x] x)"))
    "round-trip: defn shape")
  (assert-equal t "[1 2 3]" &(Located.str &(first-form "[1 2 3]")) "array")
  (assert-equal t
    "$[0 0 0]"
    &(Located.str &(first-form "$[0 0 0]"))
    "static array")
  (assert-equal t "{:a 1}" &(Located.str &(first-form "{:a 1}")) "dict")

  (assert-equal t "(ref x)" &(Located.str &(first-form "&x")) "ref reader macro")
  (assert-equal t
    "(deref x)"
    &(Located.str &(first-form "~x"))
    "deref reader macro")
  (assert-equal t
    "(copy x)"
    &(Located.str &(first-form "@x"))
    "copy reader macro")
  (assert-equal t
    "(quote x)"
    &(Located.str &(first-form "'x"))
    "quote reader macro")
  (assert-equal t
    "(quasiquote x)"
    &(Located.str &(first-form "`x"))
    "quasiquote reader macro")
  (assert-equal t
    "(unquote x)"
    &(Located.str &(first-form "%x"))
    "unquote reader macro")
  (assert-equal t
    "(unquote-splicing x)"
    &(Located.str &(first-form "%@x"))
    "unquote-splicing reader macro")

  (assert-equal t 2 (Array.length &(unsafe-parse "; hi
42")) "comment + form = two top-level nodes")
  (assert-equal t ";a
" &(Located.str &(first-form ";a")) "comment node round-trip")
  (assert-equal t 3 (Array.length &(unsafe-parse "1 ; mid
 2")) "comment between two top-level forms")
  (assert-equal t 3 (let [f (first-form "(a ; comment
 b)")] (match-ref (Located.form &f) (Lst items) (Array.length items) _ -1)) "comment inside list survives")

  (assert-equal t 3 (Array.length &(unsafe-parse "; header comment
(defn foo [x] x)
(def y 1)")) "comment + two defns at top level")

  (assert-equal t
    1
    @(Info.line (Located.info &(first-form "42")))
    "top-level form starts on line 1")
  (assert-equal t
    1
    @(Info.col (Located.info &(first-form "42")))
    "top-level form starts on col 1")
  (assert-equal t 2 @(Info.line (Located.info &(first-form "
42"))) "leading newline pushes line to 2")
  (assert-equal t
    4
    @(Info.col (Located.info &(first-form "   x")))
    "leading spaces push col forward")
  (assert-equal t
    2
    (first-child-col "(a b)")
    "child position is relative to source, not parent")
  (assert-true t (is-double? "1e6") "1e6 parses as Double")
  (assert-true t (is-double? "1e+06") "1e+06 parses as Double")
  (assert-true t (is-double? "1.5e-3") "1.5e-3 parses as Double")
  (assert-true t (is-float? "1e6f") "1e6f parses as Float")
  (assert-equal t
    2
    (Array.length &(unsafe-parse "1e6 x"))
    "1e6 followed by symbol parses as two top-level forms")

  (assert-equal t
    "\"µs\""
    &(Located.str &(first-form "\"µs\""))
    "string with µ (2-byte UTF-8) round-trips")

  (assert-equal t
    "10.0"
    &(Located.str &(first-form "10.0"))
    "10.0 round-trips as Double, not Int")
  ; Whole-number doubles that don't round-trip through `%g` fall back
  ; to `%.17g` (which renders an integer without exponent) and then get
  ; `.0` appended so they still parse as Double.
  (assert-equal t
    "999999999.0"
    &(Located.str &(first-form "999999999.0"))
    "999999999.0 round-trips with .0 suffix, not lossy scientific notation")
  ; A Double written with high precision keeps that precision.
  (assert-equal t
    "3.14159265358979"
    &(Located.str &(first-form "3.14159265358979"))
    "high-precision Double round-trips bit-exact")
  ; Carp's lexer doesn't accept scientific notation (`5e-15`), so very
  ; small doubles get rendered as plain decimal even at the cost of a
  ; long output.
  (assert-equal t
    "0.000000000000005633189227582935"
    &(Located.str &(first-form "0.000000000000005633189227582935"))
    "tiny Double renders in decimal, not scientific notation")

  (assert-equal t
    2
    @(Info.pos (Located.end &(first-form "42")))
    "atom end pos is byte-after-last")
  (assert-equal t
    5
    @(Info.pos (Located.end &(first-form "(a b)")))
    "list end pos is byte-after-`)`")
  (assert-equal t 2 @(Info.line (Located.end &(first-form "(a
 b)"))) "multi-line form's end line tracks where it closed")

  (assert-equal t "\"a
b\"" &(Located.str &(first-form "\"a
b\"")) "string with literal newline stays as literal newline")

  (assert-equal t
    "\"\\t\""
    &(Located.str &(first-form "\"\\t\""))
    "round-trip: tab escape")
  (assert-equal t
    "\"A\""
    &(Located.str &(first-form "\"\\x41\""))
    "hex escape \\x41 produces A")
  (assert-equal t
    "\"A\""
    &(Located.str &(first-form "\"\\u0041\""))
    "unicode escape \\u0041 produces A")
  (assert-equal t
    "\"J\""
    &(Located.str &(first-form "\"\\x4a\""))
    "hex escape \\x4a produces J")
  (assert-equal t
    "\"A3\""
    &(Located.str &(first-form "\"\\x413\""))
    "hex escape caps at 2 digits: \\x413 is A then literal 3")
  (assert-equal t
    "\"😀\""
    &(Located.str &(first-form "\"\\U0001F600\""))
    "string \\U escape decodes to its UTF-8 bytes")

  ; unknown escapes pass through verbatim and digit runs read as one
  ; character code, matching the reference compiler's reader
  (assert-false t (parse-error? "\"\\z\"") "unknown escape \\z passes through")
  (assert-false t (parse-error? "\"\\q\"") "unknown escape \\q passes through")

  ; a malformed \u, \U or \x, and a digit run shorter than two digits, are
  ; passed through verbatim by the reference; these pin its measured bytes
  (assert-equal t
    &[92b 117b 49b 50b]
    &(str-bytes "\"\\u12\"")
    "\\u with too few hex digits passes through")
  (assert-equal t
    &[92b 117b 90b 90b 90b 90b]
    &(str-bytes "\"\\uZZZZ\"")
    "\\u with non-hex chars passes through")
  (assert-equal t
    &[92b 117b 71b 72b 73b 74b]
    &(str-bytes "\"\\uGHIJ\"")
    "\\u with hex-adjacent chars passes through")
  (assert-equal t
    &[92b 85b 52b 49b]
    &(str-bytes "\"\\U41\"")
    "\\U with too few hex digits passes through")
  (assert-equal t
    &[92b 85b 48b 48b 48b 48b 71b 72b 73b 74b]
    &(str-bytes "\"\\U0000GHIJ\"")
    "\\U with non-hex chars passes through")
  (assert-equal t
    &[92b 120b]
    &(str-bytes "\"\\x\"")
    "\\x without hex digits passes through")
  (assert-equal t
    &[92b 120b 90b]
    &(str-bytes "\"\\xZ\"")
    "\\x with a non-hex char passes through")
  (assert-equal t
    &[92b 120b 90b 90b]
    &(str-bytes "\"\\xZZ\"")
    "\\x with non-hex chars passes through")
  (assert-equal t &[92b 49b] &(str-bytes "\"\\1\"") "\\1 passes through")
  (assert-equal t &[92b 55b] &(str-bytes "\"\\7\"") "\\7 passes through")
  (assert-equal t &[92b 48b] &(str-bytes "\"\\0\"") "\\0 passes through")
  (assert-equal t &[92b 57b] &(str-bytes "\"\\9\"") "\\9 passes through")
  (assert-equal t
    &[92b 48b 56b]
    &(str-bytes "\"\\08\"")
    "\\08 is one digit and passes through")
  (assert-equal t
    &[92b 49b 56b]
    &(str-bytes "\"\\18\"")
    "\\18 is one digit and passes through")
  (assert-equal t
    &[18b]
    &(str-bytes "\"\\12\"")
    "a two-digit run reads as one character code")
  (assert-equal t
    &[196b 163b]
    &(str-bytes "\"\\123\"")
    "a longer digit run reads as one character code")
  (assert-equal t &[65b] &(str-bytes "\"\\x41\"") "\\x41 still reads as A")

  (assert-equal t
    0
    (bad-string-bytes)
    "every string byte 1-255 renders printably and re-parses identically")
  (assert-equal t
    0
    (bad-char-codes)
    "every char code 1-255 renders printably and re-parses identically")
  (assert-equal t
    "\"\\a\\b\\f\\v\""
    &(Located.str &(first-form "\"\\a\\b\\f\\v\""))
    "round-trip: \\a \\b \\f \\v keep their escapes")
  (assert-equal t
    "\"\\u001b\""
    &(Located.str &(first-form "\"\\u001b\""))
    "unnamed control byte in a string renders as \\u")
  (assert-equal t
    "\\u0007"
    &(Located.str &(first-form "\\u0007"))
    "unnamed control byte as a char literal renders as \\u")
  (assert-equal t
    "\\backspace"
    &(Located.str &(first-form "\\backspace"))
    "named control char literal keeps its name")

  (assert-true t (parse-error? "(") "unbalanced open paren errors")
  (assert-true t (parse-error? "\"unterminated") "unterminated string errors"))
