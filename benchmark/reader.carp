(load "../carp-reader.carp")
(Project.no-echo)

(defn strict [source]
  (match (Reader.parse source)
    (Result.Error error)
      (do (IO.errorln &(Parser.format-error &error)) (System.exit 1) 0)
    (Result.Success forms) (Array.length &forms)))

(defn syntax [source]
  (let [document (Reader.read-syntax source)]
    (if (Array.empty? (ReaderDocument.issues &document))
      (Array.length (ReaderDocument.nodes &document))
      (do (IO.errorln "benchmark input has syntax issues") (System.exit 1) 0))))

(defn main []
  (let [argc (StaticArray.length &System.args)
        valid (or (Int.= argc 2)
                  (and (Int.= argc 3)
                       (String.= (StaticArray.unsafe-nth &System.args 2)
                                 "syntax")))]
    (if (not valid)
      (do (IO.errorln "usage: reader-bench SOURCE [syntax]") (System.exit 1))
      (match (IO.read-file (StaticArray.unsafe-nth &System.args 1))
        (Result.Error error) (do (IO.errorln &error) (System.exit 1))
        (Result.Success source)
          (let-do [read (if (Int.= argc 3) syntax strict)
                   start (System.nanotime)
                   count 0]
            (for [i 0 100] (set! count (Int.+ count (read &source))))
            (IO.println
              &(fmt "%s %d"
                    &(Uint64.str (Uint64.- (System.nanotime) start))
                    count)))))))
