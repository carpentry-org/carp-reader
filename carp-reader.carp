(load "git@github.com:carpentry-org/parsec@0.2.0")
(load "git@github.com:carpentry-org/strbuf@0.1.0")

(doc Info "is the parser-captured source position of a form: byte
offset `pos`, `line`, and `col`.")
(deftype Info [pos Int
               line Int
               col Int])

(doc Form "is a representation of a Carp source-form AST. Every form
in Carp source maps to one `Form` variant. Recursive children are
`Located` so position info is preserved at every node.")

(deftype Form
  (Itg [Int])
  (Byt [Byte])
  (Lng [Long])
  (Flt [Float])
  (Dbl [Double])
  (Bol [Bool])
  (Chr [Char])
  (Str [String])
  (Pat [String])
  (Sym [(Array String)])
  (Lst [(Array (Box Located))])
  (Arr [(Array (Box Located))])
  (StaticArr [(Array (Box Located))])
  (Dict [(Array (Box Located))])
  (Cmt [String]))

(doc Located "is a `Form` paired with the `Info` captured at its
start position (`info`) and the position just after its last byte
(`end`). The parser emits `Located` for every node, top-level and
nested. Synthesized nodes (reader-macro expansions) carry
`Info.synthetic` for both.")
(deftype Located [form Form
                  info Info
                  end Info])

(defmodule Form
  (private join-children)
  (hidden join-children)
  (defn join-children [items]
    (let-do [sb (StringBuf.create)]
      (for [i 0 (Array.length items)]
        (do
          (when (Int.> i 0) (StringBuf.append-str &sb " "))
          (StringBuf.append-str &sb
                                &(Form.str
                                  (Located.form (Box.peek (Array.unsafe-nth items
                                                                            i)))))))
      (StringBuf.to-string &sb)))

  (private join-segments)
  (hidden join-segments)
  (defn join-segments [segs]
    (let-do [sb (StringBuf.create)]
      (for [i 0 (Array.length segs)]
        (do
          (when (Int.> i 0) (StringBuf.append-str &sb "."))
          (StringBuf.append-str &sb (Array.unsafe-nth segs i))))
      (StringBuf.to-string &sb)))

  (private escape-string-byte)
  (hidden escape-string-byte)
  (doc escape-string-byte "renders a byte for inclusion in a string
literal. `\\` and `\"` must be escaped to keep the literal valid;
`\\r` and `\\t` are kept as escapes because users rarely write
literal carriage returns / tabs in source. `\\n` (literal newline)
is emitted as a raw newline byte so multi-line string literals
round-trip readably.")
  (defn escape-string-byte [b]
    (cond
      (Char.= b \\) @"\\\\"
      (Char.= b \") @"\\\""
      (Char.= b \tab) @"\\t"
      (Char.= b \return) @"\\r"
      (String.from-bytes &[(Byte.from-int (Int.bit-and 255 (Char.to-int b)))])))

  (private escape-string)
  (hidden escape-string)
  (doc escape-string "byte-walks `s`, applying `escape-string-byte`. CRLF
(`\\r` followed by raw `\\n`) is emitted as the escape pair `\\r\\n` so
protocol-style strings (HTTP, Redis) keep their line endings explicit
on the source side. A standalone `\\n` is kept raw — multi-line doc
strings round-trip readably.")
  (defn escape-string [s]
    (let-do [sb (StringBuf.create)
             n (String.length s)
             i 0]
      (while-do (Int.< i n)
        (let-do [b (String.char-at s i)
                 crlf? (and (Char.= b \return)
                            (and (Int.< (Int.inc i) n)
                                 (Char.= (String.char-at s (Int.inc i)) \newline)))]
          (if crlf?
            (do (StringBuf.append-str &sb "\\r\\n") (set! i (Int.+ i 2)))
            (do
              (StringBuf.append-str &sb &(escape-string-byte b))
              (set! i (Int.inc i))))))
      (StringBuf.to-string &sb)))

  (private show-char)
  (hidden show-char)
  (defn show-char [c]
    (cond
      (Char.= c \space) @"\\space"
      (Char.= c \tab) @"\\tab"
      (Char.= c \newline) @"\\newline"
      (Char.= c \return) @"\\return"
      (Char.= c \backspace) @"\\backspace"
      (Char.= c \formfeed) @"\\formfeed"
      (Char.= c \") @"\\\""
      (Int.> (Char.to-int c) 127) (fmt "\\u%04x" (Char.to-int c))
      (fmt "\\%c" c)))

  (doc str "renders an `Form` back to source-like text. Round-trips
  for syntactic content; whitespace around comments is left to the
  caller's formatting pass.")
  (private double-round-trips?)
  (hidden double-round-trips?)
  (defn double-round-trips? [s d]
    (match (Double.from-string s)
      (Maybe.Just d2) (Double.= d2 d)
      (Maybe.Nothing) false))

  (private decimal-only?)
  (hidden decimal-only?)
  (defn decimal-only? [s]
    (not (or (String.contains? s \e) (String.contains? s \E))))

  (private strip-trailing-zeros)
  (hidden strip-trailing-zeros)
  (doc strip-trailing-zeros "for a decimal string containing `.`, drops
trailing `0` digits but keeps at least one digit after the decimal point
so the result remains lexically a `Double` (e.g. `\"10.000\"` becomes
`\"10.0\"`, not `\"10.\"`).")
  (defn strip-trailing-zeros [s]
    (if (not (String.contains? s \.))
      @s
      (let-do [bs (String.chars s)
               n (Array.length &bs)
               end n]
        (while-do (and (Int.> end 2)
                       (Char.= @(Array.unsafe-nth &bs (Int.dec end)) \0))
          (set! end (Int.dec end)))
        (when (Char.= @(Array.unsafe-nth &bs (Int.dec end)) \.)
          (set! end (Int.inc end)))
        (String.from-chars &(Array.prefix &bs end)))))

  (private double-str)
  (hidden double-str)
  (doc double-str "renders a `Double` as a decimal literal that
round-trips and parses with Carp's lexer (which does NOT accept
scientific notation: only `digits.digits`).

Tries `Double.str` (`%g`, 6 sig figs) first, which is short and works
for values the user wrote concisely. Falls back to `%.17g` (full
round-trip precision). If either uses an exponent, walks `%.Pf` with
P growing from 17 up to 330 (which covers the entire IEEE 754
dynamic range down to denormals near 5e-324) and picks the smallest
P whose stripped output still round-trips. Appends `.0` when the
result has no decimal point so it parses as `Double`, not `Int`.")
  (defn double-str [d]
    (let-do [s (Double.str d)]
      (when (or (not (decimal-only? &s)) (not (double-round-trips? &s d)))
        (set! s (Double.format "%.17g" d)))
      (when-do (not (decimal-only? &s))
        (let-do [precs [17 21 25 30 40 50 70 100 150 220 330]
                 n (Array.length &precs)
                 i 0]
          (while-do (Int.< i n)
            (let-do [p @(Array.unsafe-nth &precs i)
                     fmt-str (fmt "%%.%df" p)
                     candidate (strip-trailing-zeros &(Double.format &fmt-str d))]
              (when-do (double-round-trips? &candidate d)
                (set! s candidate)
                (set! i n)))
            (set! i (Int.inc i)))))
      (if (String.contains? &s \.) s (String.append &s ".0"))))

  (defn str [a]
    (match-ref a
      (Itg n) (Int.str @n)
      (Byt b) (Byte.str @b)
      (Lng n) (String.append &(Long.str @n) "l")
      (Flt f) (Float.str @f)
      (Dbl d) (double-str @d)
      (Bol b) (if @b @"true" @"false")
      (Chr c) (show-char @c)
      (Str s) (fmt "\"%s\"" &(escape-string s))
      (Pat p) (fmt "#\"%s\"" p)
      (Sym segs) (join-segments segs)
      (Lst items) (fmt "(%s)" &(join-children items))
      (Arr items) (fmt "[%s]" &(join-children items))
      (StaticArr items) (fmt "$[%s]" &(join-children items))
      (Dict items) (fmt "{%s}" &(join-children items))
      (Cmt s) (fmt ";%s
" s)))
  (implements str Form.str))

(defmodule Info
  (doc synthetic "is an `Info` for synthesized nodes (e.g. reader-macro
expansions like `&x` → `(ref x)`, where the `ref` symbol isn't in the
source). `pos`, `line`, and `col` are all `0`.")
  (defn synthetic [] (Info.init 0 0 0)))

(defmodule Located
  (doc str "renders a `Located` as source-like text via the underlying
`Form.str`. Position info is dropped — use `Located.info` directly if
you need it.")
  (defn str [l] (Form.str (Located.form l)))
  (implements str Located.str))

(defmodule Reader
  (private ws-byte?)
  (hidden ws-byte?)
  (defn ws-byte? [c]
    (or (or (Char.= c \space) (Char.= c \tab))
        (or (or (Char.= c \newline) (Char.= c \return)) (Char.= c \,))))

  (private skip-ws)
  (hidden skip-ws)
  (defn skip-ws []
    (Parser.map (Parser.take-while (fn [c] (ws-byte? c))) (fn [_] ())))

  (private digit?)
  (hidden digit?)
  (defn digit? [c] (and (Char.>= c \0) (Char.<= c \9)))

  (private hex-digit?)
  (hidden hex-digit?)
  (defn hex-digit? [c]
    (or (digit? c)
        (or (and (Char.>= c \a) (Char.<= c \f))
            (and (Char.>= c \A) (Char.<= c \F)))))

  (private bin-digit?)
  (hidden bin-digit?)
  (defn bin-digit? [c] (or (Char.= c \0) (Char.= c \1)))

  (private alpha?)
  (hidden alpha?)
  (defn alpha? [c]
    (or (and (Char.>= c \A) (Char.<= c \Z)) (and (Char.>= c \a) (Char.<= c \z))))

  (private sym-extra?)
  (hidden sym-extra?)
  (defn sym-extra? [c]
    (or
      (or (or (Char.= c \+) (Char.= c \-)) (or (Char.= c \*) (Char.= c \/)))
      (or
        (or (or (Char.= c \?) (Char.= c \!)) (or (Char.= c \>) (Char.= c \<)))
        (or (or (Char.= c \=) (Char.= c \_)) (Char.= c \:)))))

  (private high-ascii?)
  (hidden high-ascii?)
  (defn high-ascii? [c] (Int.> (Int.bit-and 255 (Char.to-int c)) 127))

  (private sym-byte?)
  (hidden sym-byte?)
  (defn sym-byte? [c]
    (or (or (alpha? c) (digit? c)) (or (sym-extra? c) (high-ascii? c))))

  (private hex-value)
  (hidden hex-value)
  (defn hex-value [c]
    (cond
      (and (Char.>= c \0) (Char.<= c \9))
        (Int.- (Char.to-int c) (Char.to-int \0))
      (and (Char.>= c \a) (Char.<= c \f))
        (Int.+ 10 (Int.- (Char.to-int c) (Char.to-int \a)))
      (and (Char.>= c \A) (Char.<= c \F))
        (Int.+ 10 (Int.- (Char.to-int c) (Char.to-int \A)))
      0))

  (private read-hex)
  (hidden read-hex)
  (defn read-hex [src pos count]
    (let-do [acc 0]
      (for [i 0 count]
        (set! acc
              (Int.+ (Int.* acc 16)
                     (hex-value (String.char-at src (Int.+ pos i))))))
      acc))

  (private push-utf8-bytes)
  (hidden push-utf8-bytes)
  (doc push-utf8-bytes "encodes a Unicode codepoint as UTF-8 bytes and
appends them to `bytes`. Used by `\\u` / `\\U` string escapes which
specify codepoints rather than raw bytes.")
  (defn push-utf8-bytes [bytes cp]
    (cond
      (Int.< cp 128) (Array.push-back bytes (Byte.from-int cp))
      (Int.< cp 2048)
        (let-do [out bytes]
          (set! out
                (Array.push-back out
                                 (Byte.from-int
                                   (Int.bit-or 192 (Int.bit-shift-right cp 6)))))
          (Array.push-back out
                           (Byte.from-int (Int.bit-or 128 (Int.bit-and cp 63)))))
      (Int.< cp 65536)
        (let-do [out bytes]
          (set! out
                (Array.push-back out
                                 (Byte.from-int
                                   (Int.bit-or 224 (Int.bit-shift-right cp 12)))))
          (set! out
                (Array.push-back out
                                 (Byte.from-int
                                   (Int.bit-or 128
                                               (Int.bit-and (Int.bit-shift-right cp
                                                                                 6)
                                                            63)))))
          (Array.push-back out
                           (Byte.from-int (Int.bit-or 128 (Int.bit-and cp 63)))))
      (let-do [out bytes]
        (set! out
              (Array.push-back out
                               (Byte.from-int
                                 (Int.bit-or 240 (Int.bit-shift-right cp 18)))))
        (set! out
              (Array.push-back out
                               (Byte.from-int
                                 (Int.bit-or 128
                                             (Int.bit-and (Int.bit-shift-right cp
                                                                               12)
                                                          63)))))
        (set! out
              (Array.push-back out
                               (Byte.from-int
                                 (Int.bit-or 128
                                             (Int.bit-and (Int.bit-shift-right cp
                                                                               6)
                                                          63)))))
        (Array.push-back out
                         (Byte.from-int (Int.bit-or 128 (Int.bit-and cp 63)))))))

  (private push-byte)
  (hidden push-byte)
  (defn push-byte [bytes c]
    (Array.push-back bytes (Byte.from-int (Int.bit-and 255 (Char.to-int c)))))

  (private parse-digits-from)
  (hidden parse-digits-from)
  (defn parse-digits-from [src digit-start digit-end base negate]
    (let-do [acc 0l
             b-long (Long.from-int base)]
      (for [i digit-start digit-end]
        (set! acc
              (Long.+ (Long.* acc b-long)
                      (Long.from-int (hex-value (String.char-at src i))))))
      (if negate (Long.neg acc) acc)))

  (private is-base-digit?)
  (hidden is-base-digit?)
  (defn is-base-digit? [c base]
    (cond
      (Int.= base 16) (hex-digit? c)
      (Int.= base 2) (bin-digit? c)
      (digit? c)))

  (private scan-exponent)
  (hidden scan-exponent)
  (doc scan-exponent "scans a decimal exponent starting at `pos`. If
the byte at `pos` is `e` or `E` and is followed by an optional sign
and at least one digit, returns the position just past the last
exponent digit. Otherwise returns `pos` unchanged, signalling that
there is no exponent here.")
  (defn scan-exponent [src len pos]
    (if (Int.>= pos len)
      pos
      (let [c0 (String.char-at src pos)]
        (if (not (or (Char.= c0 \e) (Char.= c0 \E)))
          pos
          (let-do [p (Int.inc pos)]
            (when (and (Int.< p len)
                       (let [c (String.char-at src p)]
                         (or (Char.= c \+) (Char.= c \-))))
              (set! p (Int.inc p)))
            (let-do [digits-start p]
              (while-do (and (Int.< p len) (digit? (String.char-at src p)))
                (set! p (Int.inc p)))
              (if (Int.> p digits-start) p pos)))))))

  (private number)
  (hidden number)
  (defn number []
    (Parser.init
      (fn [src len cur]
        (let-do [start @(Cursor.pos cur)
                 pos start
                 negate false]
          (when-do (and (Int.< pos len) (Char.= (String.char-at src pos) \-))
            (set! negate true)
            (set! pos (Int.inc pos)))
          (let-do [base 10
                   digit-start pos]
            (when (and (Int.<= (Int.+ pos 2) len)
                       (Char.= (String.char-at src pos) \0))
              (let [c1 (String.char-at src (Int.inc pos))]
                (cond
                  (Char.= c1 \x)
                    (do
                      (set! base 16)
                      (set! pos (Int.+ pos 2))
                      (set! digit-start pos))
                  (Char.= c1 \b)
                    (do
                      (set! base 2)
                      (set! pos (Int.+ pos 2))
                      (set! digit-start pos))
                  ())))
            (let-do [int-end pos]
              (while-do (and (Int.< int-end len)
                             (is-base-digit? (String.char-at src int-end) base))
                (set! int-end (Int.inc int-end)))
              (set! pos int-end)
              (if (Int.= pos digit-start)
                (Reply.ErrEmpty (ParseErr.expected-at cur @"number"))
                (let-do [int-value (parse-digits-from src
                                                      digit-start
                                                      int-end
                                                      base
                                                      negate)
                         next-c (if (Int.< pos len)
                           (String.char-at src pos)
                           \space)]
                  (cond
                    (Char.= next-c \.)
                      (let-do [frac-start (Int.inc pos)
                               frac-end frac-start]
                        (while-do (and (Int.< frac-end len)
                                       (digit? (String.char-at src frac-end)))
                          (set! frac-end (Int.inc frac-end)))
                        (if (Int.= frac-end frac-start)
                          (Reply.ErrConsumed
                            (ParseErr.expected-at cur @"fractional digits"))
                          (let-do [exp-end (scan-exponent src len frac-end)
                                   post exp-end
                                   is-float false]
                            (when-do (and (Int.< post len)
                                          (Char.= (String.char-at src post) \f))
                              (set! is-float true)
                              (set! post (Int.inc post)))
                            (let [num-text (String.byte-slice src start exp-end)]
                              (match (Double.from-string &num-text)
                                (Maybe.Just d)
                                  (Reply.OkConsumed
                                    (if is-float
                                      (Form.Flt (Double.to-float d))
                                      (Form.Dbl d))
                                    (Cursor.advance-by cur
                                                       (Int.- post start)
                                                       false))
                                (Maybe.Nothing)
                                  (Reply.ErrConsumed
                                    (ParseErr.expected-at cur
                                                          (if is-float
                                                            @"float"
                                                            @"double"))))))))
                    (or (Char.= next-c \e) (Char.= next-c \E))
                      (let-do [exp-end (scan-exponent src len pos)]
                        (if (Int.= exp-end pos)
                          (Reply.OkConsumed (Form.Itg (Long.to-int int-value))
                                            (Cursor.advance-by cur
                                                               (Int.- pos start)
                                                               false))
                          (let-do [post exp-end
                                   is-float false]
                            (when-do (and (Int.< post len)
                                          (Char.= (String.char-at src post) \f))
                              (set! is-float true)
                              (set! post (Int.inc post)))
                            (let [num-text (String.byte-slice src start exp-end)]
                              (match (Double.from-string &num-text)
                                (Maybe.Just d)
                                  (Reply.OkConsumed
                                    (if is-float
                                      (Form.Flt (Double.to-float d))
                                      (Form.Dbl d))
                                    (Cursor.advance-by cur
                                                       (Int.- post start)
                                                       false))
                                (Maybe.Nothing)
                                  (Reply.ErrConsumed
                                    (ParseErr.expected-at cur
                                                          (if is-float
                                                            @"float"
                                                            @"double"))))))))
                    (Char.= next-c \b)
                      (Reply.OkConsumed
                        (Form.Byt (Byte.from-int (Long.to-int int-value)))
                        (Cursor.advance-by cur (Int.- (Int.inc pos) start) false))
                    (Char.= next-c \l)
                      (Reply.OkConsumed (Form.Lng int-value)
                                        (Cursor.advance-by cur
                                                           (Int.- (Int.inc pos)
                                                                  start)
                                                           false))
                    (Char.= next-c \f)
                      (let [num-text (String.byte-slice src start pos)]
                        (match (Double.from-string &num-text)
                          (Maybe.Just d)
                            (Reply.OkConsumed (Form.Flt (Double.to-float d))
                                              (Cursor.advance-by cur
                                                                 (Int.- (Int.inc pos)
                                                                        start)
                                                                 false))
                          (Maybe.Nothing)
                            (Reply.ErrConsumed (ParseErr.expected-at cur
                                                                     @"float"))))
                    (Reply.OkConsumed (Form.Itg (Long.to-int int-value))
                                      (Cursor.advance-by cur
                                                         (Int.- pos start)
                                                         false)))))))))))

  (private string-)
  (hidden string-)
  (defn string- []
    (Parser.init
      (fn [src len cur]
        (let [start @(Cursor.pos cur)]
          (if (or (Int.>= start len)
                  (not (Char.= (String.char-at src start) \")))
            (Reply.ErrEmpty (ParseErr.expected-at cur @"string"))
            (let-do [c (Cursor.advance cur \")
                     bytes (the (Array Byte) [])
                     going true
                     err @""]
              (while-do (and going (Int.= 0 (String.length &err)))
                (if (Int.>= @(Cursor.pos &c) len)
                  (set! err @"closing quote")
                  (let [ch (String.char-at src @(Cursor.pos &c))]
                    (cond
                      (Char.= ch \")
                        (do (set! c (Cursor.advance &c ch)) (set! going false))
                      (Char.= ch \\)
                        (if (Int.>= (Int.+ @(Cursor.pos &c) 1) len)
                          (set! err @"closing quote")
                          (let [esc (String.char-at src
                                                    (Int.+ @(Cursor.pos &c) 1))]
                            (cond
                              (Char.= esc \n)
                                (do
                                  (set! bytes (push-byte bytes \newline))
                                  (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \t)
                                (do
                                  (set! bytes (push-byte bytes \tab))
                                  (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \r)
                                (do
                                  (set! bytes (push-byte bytes \return))
                                  (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \b)
                                (do
                                  (set! bytes (push-byte bytes \backspace))
                                  (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \f)
                                (do
                                  (set! bytes (push-byte bytes \formfeed))
                                  (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \v)
                                (do
                                  (set! bytes
                                        (Array.push-back bytes
                                                         (Byte.from-int 11)))
                                  (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \a)
                                (do
                                  (set! bytes
                                        (Array.push-back bytes (Byte.from-int 7)))
                                  (set! c (Cursor.advance-by &c 2 false)))
                              (or (Char.= esc \\)
                                  (or (Char.= esc \") (Char.= esc \')))
                                (do
                                  (set! bytes (push-byte bytes esc))
                                  (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \x)
                                (let-do [digits-start (Int.+ @(Cursor.pos &c) 2)
                                         end digits-start]
                                  (while-do (and (Int.< end len)
                                                 (hex-digit? (String.char-at src
                                                                             end)))
                                    (set! end (Int.inc end)))
                                  (if (Int.> end digits-start)
                                    (do
                                      (set! bytes
                                            (Array.push-back bytes
                                                             (Byte.from-int
                                                               (Int.bit-and 255
                                                                            (read-hex src
                                                                                      digits-start
                                                                                      (Int.- end
                                                                                             digits-start))))))
                                      (set! c
                                            (Cursor.advance-by &c
                                                               (Int.- end
                                                                      @(Cursor.pos &c))
                                                               false)))
                                    (set! err @"hex digits after \\x")))
                              (Char.= esc \u)
                                (if (Int.>= (Int.+ @(Cursor.pos &c) 6)
                                            (Int.inc len))
                                  (set! err @"4 hex digits in \\u escape")
                                  (let-do [hex-start (Int.+ @(Cursor.pos &c) 2)
                                           all-hex true]
                                    (for [j hex-start (Int.+ hex-start 4)]
                                      (unless (hex-digit? (String.char-at src j))
                                        (set! all-hex false)))
                                    (if all-hex
                                      (do
                                        (set! bytes
                                              (push-utf8-bytes bytes
                                                               (read-hex src
                                                                         hex-start
                                                                         4)))
                                        (set! c (Cursor.advance-by &c 6 false)))
                                      (set! err @"hex digits in \\u escape"))))
                              (Char.= esc \U)
                                (if (Int.>= (Int.+ @(Cursor.pos &c) 10)
                                            (Int.inc len))
                                  (set! err @"8 hex digits in \\U escape")
                                  (let-do [hex-start (Int.+ @(Cursor.pos &c) 2)
                                           all-hex true]
                                    (for [j hex-start (Int.+ hex-start 8)]
                                      (unless (hex-digit? (String.char-at src j))
                                        (set! all-hex false)))
                                    (if all-hex
                                      (do
                                        (set! bytes
                                              (push-utf8-bytes bytes
                                                               (read-hex src
                                                                         hex-start
                                                                         8)))
                                        (set! c (Cursor.advance-by &c 10 false)))
                                      (set! err @"hex digits in \\U escape"))))
                              (set! err @"valid escape sequence"))))
                      (do
                        (set! bytes (push-byte bytes ch))
                        (set! c (Cursor.advance &c ch)))))))
              (if (Int.> (String.length &err) 0)
                (Reply.ErrConsumed (ParseErr.expected-at &c err))
                (Reply.OkConsumed (Form.Str (String.from-bytes &bytes)) c))))))))

  (private raw-string)
  (hidden raw-string)
  (defn raw-string []
    (Parser.init
      (fn [src len cur]
        (let [start @(Cursor.pos cur)]
          (if (or (Int.>= (Int.+ start 1) len)
                  (or
                    (not (Char.= (String.char-at src start) \r))
                    (not (Char.= (String.char-at src (Int.+ start 1)) \"))))
            (Reply.ErrEmpty (ParseErr.expected-at cur @"raw string"))
            (let-do [c (Cursor.advance-by cur 2 false)
                     chars []
                     going true
                     err false]
              (while-do (and going (not err))
                (if (Int.>= @(Cursor.pos &c) len)
                  (set! err true)
                  (let [ch (String.char-at src @(Cursor.pos &c))]
                    (cond
                      (Char.= ch \")
                        (if (and (Int.< (Int.inc @(Cursor.pos &c)) len)
                                 (Char.=
                                   (String.char-at src
                                                   (Int.inc @(Cursor.pos &c)))
                                   \"))
                          (do
                            (set! chars (Array.push-back chars \"))
                            (set! c (Cursor.advance-by &c 2 false)))
                          (do (set! c (Cursor.advance &c ch)) (set! going false)))
                      (do
                        (set! chars (Array.push-back chars ch))
                        (set! c (Cursor.advance &c ch)))))))
              (if err
                (Reply.ErrConsumed (ParseErr.expected-at &c @"closing quote"))
                (Reply.OkConsumed (Form.Str (String.from-chars &chars)) c))))))))

  (private pattern-)
  (hidden pattern-)
  (defn pattern- []
    (Parser.init
      (fn [src len cur]
        (let [start @(Cursor.pos cur)]
          (if (or (Int.>= (Int.+ start 1) len)
                  (or
                    (not (Char.= (String.char-at src start) \#))
                    (not (Char.= (String.char-at src (Int.+ start 1)) \"))))
            (Reply.ErrEmpty (ParseErr.expected-at cur @"pattern"))
            (let-do [c (Cursor.advance-by cur 2 false)
                     chars []
                     going true
                     err false]
              (while-do (and going (not err))
                (if (Int.>= @(Cursor.pos &c) len)
                  (set! err true)
                  (let [ch (String.char-at src @(Cursor.pos &c))]
                    (cond
                      (Char.= ch \")
                        (do (set! c (Cursor.advance &c ch)) (set! going false))
                      (do
                        (set! chars (Array.push-back chars ch))
                        (set! c (Cursor.advance &c ch)))))))
              (if err
                (Reply.ErrConsumed (ParseErr.expected-at &c @"closing quote"))
                (Reply.OkConsumed (Form.Pat (String.from-chars &chars)) c))))))))

  (private named-char)
  (hidden named-char)
  (defn named-char [name]
    (cond
      (= &name "space") (Maybe.Just \space)
      (= &name "tab") (Maybe.Just \tab)
      (= &name "newline") (Maybe.Just \newline)
      (= &name "return") (Maybe.Just \return)
      (= &name "backspace") (Maybe.Just \backspace)
      (= &name "formfeed") (Maybe.Just \formfeed)
      (= &name "\"") (Maybe.Just \")
      (Maybe.Nothing)))

  (private unicode-char)
  (hidden unicode-char)
  (defn unicode-char []
    (Parser.bind (Parser.byte \u)
                 (fn [_]
                   (Parser.bind
                     (Parser.slice-of
                       (Parser.count 4
                                     (Parser.satisfy (fn [c] (hex-digit? c))
                                                     @"hex digit")))
                     (fn [hex]
                       (Parser.pure
                         (Form.Chr (Char.from-int (read-hex &hex 0 4)))))))))

  (private char-)
  (hidden char-)
  (defn char- []
    (Parser.bind (Parser.byte \\)
                 (fn [_]
                   (Parser.choice
                     [(Parser.try (unicode-char))
                      (Parser.bind
                        (Parser.take-while1 (fn [c] (sym-byte? c)))
                        (fn [name]
                          (if (= 1 (String.length &name))
                            (Parser.pure (Form.Chr (String.char-at &name 0)))
                            (match (named-char @&name)
                              (Maybe.Just c) (Parser.pure (Form.Chr c))
                              (Maybe.Nothing) (Parser.fail @"named char")))))
                      (Parser.map (Parser.any-byte) (fn [c] (Form.Chr c)))]))))

  (private segment)
  (hidden segment)
  (defn segment [] (Parser.take-while1 (fn [c] (sym-byte? c))))

  (private symbol-)
  (hidden symbol-)
  (defn symbol- []
    (Parser.map
      (Parser.label @"symbol"
                    (Parser.seq (segment)
                                (Parser.many
                                  (Parser.bind (Parser.byte \.)
                                               (fn [_] (segment))))))
      (fn [outer]
        (let [first @(Pair.a &outer)
              rest @(Pair.b &outer)]
          (let-do [segs [first]]
            (for [i 0 (Array.length &rest)]
              (set! segs (Array.push-back segs @(Array.unsafe-nth &rest i))))
            (if (Int.= 1 (Array.length &segs))
              (let [only (Array.unsafe-nth &segs 0)]
                (cond
                  (= only "true") (Form.Bol true)
                  (= only "false") (Form.Bol false)
                  (Form.Sym segs)))
              (Form.Sym segs)))))))

  (private comment-)
  (hidden comment-)
  (defn comment- []
    (Parser.map
      (Parser.then (Parser.byte \;)
                   (Parser.take-while (fn [c] (not (Char.= c \newline)))))
      (fn [s] (Form.Cmt s))))

  (private *form*)
  (def *form* (the (Parser Located) (Parser.placeholder)))

  (private *list-cell*)
  (def *list-cell* (the (Parser Form) (Parser.placeholder)))

  (private *array-cell*)
  (def *array-cell* (the (Parser Form) (Parser.placeholder)))

  (private *dict-cell*)
  (def *dict-cell* (the (Parser Form) (Parser.placeholder)))

  (private *static-array-cell*)
  (def *static-array-cell* (the (Parser Form) (Parser.placeholder)))

  (private *string-cell*)
  (def *string-cell* (the (Parser Form) (Parser.placeholder)))

  (private *raw-string-cell*)
  (def *raw-string-cell* (the (Parser Form) (Parser.placeholder)))

  (private *pattern-cell*)
  (def *pattern-cell* (the (Parser Form) (Parser.placeholder)))

  (private *char-cell*)
  (def *char-cell* (the (Parser Form) (Parser.placeholder)))

  (private *number-cell*)
  (def *number-cell* (the (Parser Form) (Parser.placeholder)))

  (private *symbol-cell*)
  (def *symbol-cell* (the (Parser Form) (Parser.placeholder)))

  (private *comment-cell*)
  (def *comment-cell* (the (Parser Form) (Parser.placeholder)))

  (private *ref-cell*)
  (def *ref-cell* (the (Parser Form) (Parser.placeholder)))

  (private *deref-cell*)
  (def *deref-cell* (the (Parser Form) (Parser.placeholder)))

  (private *copy-cell*)
  (def *copy-cell* (the (Parser Form) (Parser.placeholder)))

  (private *quote-cell*)
  (def *quote-cell* (the (Parser Form) (Parser.placeholder)))

  (private *quasiquote-cell*)
  (def *quasiquote-cell* (the (Parser Form) (Parser.placeholder)))

  (private *unquote-cell*)
  (def *unquote-cell* (the (Parser Form) (Parser.placeholder)))

  (private *unquote-splice-cell*)
  (def *unquote-splice-cell* (the (Parser Form) (Parser.placeholder)))

  (private many-forms)
  (hidden many-forms)
  (defn many-forms []
    (Parser.then (skip-ws)
                 (Parser.many
                   (Parser.map
                     (Parser.before (Parser.recurse &*form*) (skip-ws))
                     (fn [c] (Box.init c))))))

  (private list-)
  (hidden list-)
  (defn list- []
    (Parser.map
      (Parser.between (Parser.byte \() (Parser.byte \)) (many-forms))
      (fn [items] (Form.Lst items))))

  (private array-)
  (hidden array-)
  (defn array- []
    (Parser.map
      (Parser.between (Parser.byte \[) (Parser.byte \]) (many-forms))
      (fn [items] (Form.Arr items))))

  (private static-array)
  (hidden static-array)
  (defn static-array []
    (Parser.map
      (Parser.between (Parser.string @"$[") (Parser.byte \]) (many-forms))
      (fn [items] (Form.StaticArr items))))

  (private dict)
  (hidden dict)
  (defn dict []
    (Parser.map
      (Parser.between (Parser.byte \{) (Parser.byte \}) (many-forms))
      (fn [items] (Form.Dict items))))

  (private macro-list)
  (hidden macro-list)
  (defn macro-list [name body]
    (Form.Lst
      [(Box.init
         (Located.init (Form.Sym [@name]) (Info.synthetic) (Info.synthetic)))
       (Box.init body)]))

  (private reader-macro)
  (hidden reader-macro)
  (defn reader-macro [open name]
    (Parser.map
      (Parser.then (Parser.string open) (Parser.recurse &*form*))
      (fn [body] (macro-list &name body))))

  (private ref-)
  (hidden ref-)
  (defn ref- [] (reader-macro @"&" @"ref"))

  (private deref-)
  (hidden deref-)
  (defn deref- [] (reader-macro @"~" @"deref"))

  (private copy-)
  (hidden copy-)
  (defn copy- [] (reader-macro @"@" @"copy"))

  (private quote-)
  (hidden quote-)
  (defn quote- [] (reader-macro @"'" @"quote"))

  (private quasiquote-)
  (hidden quasiquote-)
  (defn quasiquote- [] (reader-macro @"`" @"quasiquote"))

  (private unquote-)
  (hidden unquote-)
  (defn unquote- [] (reader-macro @"%" @"unquote"))

  (private unquote-splice-)
  (hidden unquote-splice-)
  (defn unquote-splice- [] (reader-macro @"%@" @"unquote-splicing"))

  (private form)
  (hidden form)
  (private wrap)
  (hidden wrap)
  (defn wrap [info reply]
    (match reply
      (Reply.OkConsumed v c)
        (let-do [end (Info.init @(Cursor.pos &c)
                                @(Cursor.line &c)
                                @(Cursor.col &c))]
          (Reply.OkConsumed (Located.init v info end) c))
      (Reply.OkEmpty v c)
        (let-do [end (Info.init @(Cursor.pos &c)
                                @(Cursor.line &c)
                                @(Cursor.col &c))]
          (Reply.OkEmpty (Located.init v info end) c))
      (Reply.ErrConsumed e) (Reply.ErrConsumed e)
      (Reply.ErrEmpty e) (Reply.ErrEmpty e)))

  (defn form []
    (Parser.init
      (fn [src len cur]
        (let [pos @(Cursor.pos cur)]
          (if (Int.>= pos len)
            (Reply.ErrEmpty (ParseErr.expected-at cur @"a form"))
            (let [b (String.char-at src pos)
                  info (Info.init pos @(Cursor.line cur) @(Cursor.col cur))]
              (cond
                (Char.= b \()
                  (wrap info (~(Parser.run &*list-cell*) src len cur))
                (Char.= b \[)
                  (wrap info (~(Parser.run &*array-cell*) src len cur))
                (Char.= b \{)
                  (wrap info (~(Parser.run &*dict-cell*) src len cur))
                (Char.= b \$)
                  (wrap info (~(Parser.run &*static-array-cell*) src len cur))
                (Char.= b \&)
                  (wrap info (~(Parser.run &*ref-cell*) src len cur))
                (Char.= b \~)
                  (wrap info (~(Parser.run &*deref-cell*) src len cur))
                (Char.= b \@)
                  (wrap info (~(Parser.run &*copy-cell*) src len cur))
                (Char.= b \')
                  (wrap info (~(Parser.run &*quote-cell*) src len cur))
                (Char.= b \`)
                  (wrap info (~(Parser.run &*quasiquote-cell*) src len cur))
                (Char.= b \;)
                  (wrap info (~(Parser.run &*comment-cell*) src len cur))
                (Char.= b \%)
                  (if (and (Int.< (Int.inc pos) len)
                           (Char.= (String.char-at src (Int.inc pos)) \@))
                    (wrap info
                          (~(Parser.run &*unquote-splice-cell*) src len cur))
                    (wrap info (~(Parser.run &*unquote-cell*) src len cur)))
                (Char.= b \")
                  (wrap info (~(Parser.run &*string-cell*) src len cur))
                (Char.= b \#)
                  (wrap info (~(Parser.run &*pattern-cell*) src len cur))
                (Char.= b \\)
                  (wrap info (~(Parser.run &*char-cell*) src len cur))
                (Char.= b \r)
                  (if (and (Int.< (Int.inc pos) len)
                           (Char.= (String.char-at src (Int.inc pos)) \"))
                    (wrap info (~(Parser.run &*raw-string-cell*) src len cur))
                    (wrap info (~(Parser.run &*symbol-cell*) src len cur)))
                (or (digit? b) (Char.= b \-))
                  (let [reply (~(Parser.run &*number-cell*) src len cur)]
                    (match reply
                      (Reply.OkConsumed v c) (wrap info (Reply.OkConsumed v c))
                      (Reply.OkEmpty v c) (wrap info (Reply.OkEmpty v c))
                      (Reply.ErrConsumed e) (wrap info (Reply.ErrConsumed e))
                      (Reply.ErrEmpty _)
                        (wrap info (~(Parser.run &*symbol-cell*) src len cur))))
                (wrap info (~(Parser.run &*symbol-cell*) src len cur)))))))))

  (def -init
    (do
      (set! *list-cell* (list-))
      (set! *array-cell* (array-))
      (set! *dict-cell* (dict))
      (set! *static-array-cell* (static-array))
      (set! *string-cell* (string-))
      (set! *raw-string-cell* (raw-string))
      (set! *pattern-cell* (pattern-))
      (set! *char-cell* (char-))
      (set! *number-cell* (number))
      (set! *symbol-cell* (symbol-))
      (set! *comment-cell* (comment-))
      (set! *ref-cell* (ref-))
      (set! *deref-cell* (deref-))
      (set! *copy-cell* (copy-))
      (set! *quote-cell* (quote-))
      (set! *quasiquote-cell* (quasiquote-))
      (set! *unquote-cell* (unquote-))
      (set! *unquote-splice-cell* (unquote-splice-))
      (set! *form* (form))
      0))

  (doc parse "parses a Carp source string into an array of top-level
  `Form` forms. Comments are preserved as `Form.Cmt` nodes interspersed
  with real forms.")
  (defn parse [src] (Parser.parse (many-forms) src))

  (doc parse-form "parses exactly one top-level `Form` form. Use
  `parse` for whole-file inputs.")
  (defn parse-form [src]
    (Parser.parse
      (Parser.then (skip-ws) (Parser.before (Parser.recurse &*form*) (skip-ws)))
      src)))
