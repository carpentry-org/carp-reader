(load "git@github.com:carpentry-org/parsec@0.6.2")
(load "git@github.com:carpentry-org/strbuf@0.3.0")

(doc Info "is the parser-captured source position of a form: byte
offset `pos`, `line`, and `col`.")
(deftype Info [pos Int
               line Int
               col Int])

(doc Form "is a representation of a Carp source-form AST. Every form
in Carp source maps to one `Form` variant. Recursive children are
`Located` so position info is preserved at every node.")

(deftype Form
  (Itg [Int])
  (Byt [Byte])
  (Lng [Long])
  (Flt [Float])
  (Dbl [Double])
  (Bol [Bool])
  (Chr [Char])
  (Str [String])
  (Pat [String])
  (Sym [(Array String)])
  (Lst [(Array (Box Located))])
  (Arr [(Array (Box Located))])
  (StaticArr [(Array (Box Located))])
  (Dict [(Array (Box Located))])
  (Cmt [String]))

(doc Located "is a `Form` paired with the `Info` captured at its
start position (`info`) and the position just after its last byte
(`end`). The parser emits `Located` for every node, top-level and
nested. Synthesized nodes (reader-macro expansions) carry
`Info.synthetic` for both.")
(deftype Located [form Form
                  info Info
                  end Info])

(defmodule Form
  (private join-children)
  (hidden join-children)
  (defn join-children [items]
    (let-do [sb (StringBuf.create)]
      (for [i 0 (Array.length items)]
        (do
          (when (Int.> i 0) (StringBuf.append-str &sb " "))
          (StringBuf.append-str &sb
                                &(Form.str
                                  (Located.form (Box.peek (Array.unsafe-nth items
                                                                            i)))))))
      (StringBuf.into-string sb)))

  (private join-segments)
  (hidden join-segments)
  (defn join-segments [segs]
    (let-do [sb (StringBuf.create)]
      (for [i 0 (Array.length segs)]
        (do
          (when (Int.> i 0) (StringBuf.append-str &sb "."))
          (StringBuf.append-str &sb (Array.unsafe-nth segs i))))
      (StringBuf.into-string sb)))

  (private control-code?)
  (hidden control-code?)
  (defn control-code? [i] (or (Int.< i 32) (Int.= i 127)))

  (private escape-string-byte)
  (hidden escape-string-byte)
  (defn escape-string-byte [b]
    (let [i (Int.bit-and 255 (Char.to-int b))]
      (cond
        (Char.= b \\)
        @"\\\\"
        (Char.= b \")
        @"\\\""
        (Int.= i 7)
        @"\\a"
        (Int.= i 8)
        @"\\b"
        (Int.= i 9)
        @"\\t"
        (Int.= i 11)
        @"\\v"
        (Int.= i 12)
        @"\\f"
        (Int.= i 13)
        @"\\r"
        ; \xHH is greedy in the reference reader, so \u is the only safe escape.
        (and (control-code? i) (Int./= i 10))
        (fmt "\\u%04x" i)
        (String.from-bytes &[(Byte.from-int i)]))))

  (private escape-string)
  (hidden escape-string)
  ; CRLF is emitted as the escape pair \r\n so protocol strings keep line
  ; endings explicit; a standalone \n is kept raw for readable multi-line strings.
  (defn escape-string [s]
    (let-do [sb (StringBuf.create)
             n (String.length s)
             i 0]
      (while-do (Int.< i n)
        (let-do [b (String.char-at s i)
                 crlf? (and (Char.= b \return)
                            (and (Int.< (Int.inc i) n)
                                 (Char.= (String.char-at s (Int.inc i)) \newline)))]
          (if crlf?
            (do (StringBuf.append-str &sb "\\r\\n") (set! i (Int.+ i 2)))
            (do
              (StringBuf.append-str &sb &(escape-string-byte b))
              (set! i (Int.inc i))))))
      (StringBuf.into-string sb)))

  (private show-char)
  (hidden show-char)
  (defn show-char [c]
    (cond
      (Char.= c \space)
      @"\\space"
      (Char.= c \tab)
      @"\\tab"
      (Char.= c \newline)
      @"\\newline"
      (Char.= c \return)
      @"\\return"
      (Char.= c \backspace)
      @"\\backspace"
      (Char.= c \formfeed)
      @"\\formfeed"
      (Char.= c \")
      @"\\\""
      ; past U+10FFFF there is no raw spelling; only this reader takes \U.
      (Int.> (Char.to-int c) 1114111)
      (fmt "\\U%08x" (Char.to-int c))
      ; Carp's char literals have no escape above the BMP, only the raw char.
      (Int.> (Char.to-int c) 65535)
      (Char.prn c)
      (or (Int.> (Char.to-int c) 127) (control-code? (Char.to-int c)))
      (fmt "\\u%04x" (Char.to-int c))
      (fmt "\\%c" c)))

  (private double-round-trips?)
  (hidden double-round-trips?)
  (defn double-round-trips? [s d]
    (match (Double.from-string s)
      (Maybe.Just d2) (Double.= d2 d)
      (Maybe.Nothing) false))

  (private decimal-only?)
  (hidden decimal-only?)
  (defn decimal-only? [s]
    (not (or (String.contains? s \e) (String.contains? s \E))))

  (private strip-trailing-zeros)
  (hidden strip-trailing-zeros)
  ; keeps at least one digit after the point so the result stays a Double.
  (defn strip-trailing-zeros [s]
    (if (not (String.contains? s \.))
      @s
      (let-do [bs (String.chars s)
               n (Array.length &bs)
               end n]
        (while-do (and (Int.> end 2)
                       (Char.= @(Array.unsafe-nth &bs (Int.dec end)) \0))
          (set! end (Int.dec end)))
        (when (Char.= @(Array.unsafe-nth &bs (Int.dec end)) \.)
          (set! end (Int.inc end)))
        (String.from-chars &(Array.prefix &bs end)))))

  (private double-str)
  (hidden double-str)
  ; Carp's lexer rejects scientific notation, so any exponent output is
  ; widened to `%.Pf` (P up to 330, covering denormals) and `.0` is appended
  ; when there is no decimal point so the result still parses as a Double.
  (defn double-str [d]
    (let-do [s (Double.str d)]
      (when (or (not (decimal-only? &s)) (not (double-round-trips? &s d)))
        (set! s (Double.unsafe-format "%.17g" d)))
      (unless-do (decimal-only? &s)
        (let-do [precs [17 21 25 30 40 50 70 100 150 220 330]
                 n (Array.length &precs)
                 i 0]
          (while-do (Int.< i n)
            ; `%%` escapes, so fmt-str carries exactly one directive
            (let-do [p @(Array.unsafe-nth &precs i)
                     fmt-str (fmt "%%.%df" p)
                     candidate (strip-trailing-zeros &(Double.unsafe-format &fmt-str
                                                                            d))]
              (when-do (double-round-trips? &candidate d)
                (set! s candidate)
                (set! i n)))
            (set! i (Int.inc i)))))
      (if (String.contains? &s \.) s (String.append &s ".0"))))

  (private float-round-trips?)
  (hidden float-round-trips?)
  (defn float-round-trips? [s f]
    (match (Double.from-string s)
      (Maybe.Just d) (Float.= (Double.to-float d) f)
      (Maybe.Nothing) false))

  (private expand-exponent)
  (hidden expand-exponent)
  ; Carp's lexer has no exponent syntax, so `-1.5e-07` becomes `-0.00000015`.
  (defn expand-exponent [s]
    (let [e (String.index-of s \e)]
      (if (Int.< e 0)
        @s
        (let [mantissa (String.chars &(String.byte-slice s 0 e))
              digits (String.from-chars
                &(Array.endo-filter &(fn [c] (Char.num? @c)) mantissa))
              suffix (String.byte-slice s (Int.inc e) (String.length s))
              exponent (Maybe.from (Int.from-string &suffix) 0)
              sign (if (String.starts-with? s "-") "-" "")]
          (if (Int.< exponent 0)
            (fmt "%s0.%s%s"
                 sign
                 &(String.repeat (Int.- -1 exponent) "0")
                 &digits)
            (let [zeros (Int.- (Int.inc exponent) (String.length &digits))]
              (fmt "%s%s%s" sign &digits &(String.repeat zeros "0"))))))))

  (private float-str)
  (hidden float-str)
  ; the fewest significant digits that read back as `f`; 9 always do.
  (defn float-str [f]
    (let-do [p 1
             s (Float.unsafe-format "%.1g" f)]
      (while-do (and (Int.< p 9) (not (float-round-trips? &s f)))
        (set! p (Int.inc p))
        (set! s (Float.unsafe-format &(fmt "%%.%dg" p) f)))
      (String.append &(expand-exponent &s) "f")))

  (doc str "renders a `Form` back to source-like text. Round-trips
  for syntactic content; whitespace around comments is left to the
  caller's formatting pass. Non-printable bytes are always escaped, so
  the output is safe to write back into a source file; the one
  exception is a literal newline inside a string, which stays raw.")
  (defn str [a]
    (match-ref a
      (Itg n) (Int.str @n)
      (Byt b) (Byte.str @b)
      (Lng n) (String.append &(Long.str @n) "l")
      (Flt f) (float-str @f)
      (Dbl d) (double-str @d)
      (Bol b) (if @b @"true" @"false")
      (Chr c) (show-char @c)
      (Str s) (fmt "\"%s\"" &(escape-string s))
      (Pat p) (fmt "#\"%s\"" p)
      (Sym segs) (join-segments segs)
      (Lst items) (fmt "(%s)" &(join-children items))
      (Arr items) (fmt "[%s]" &(join-children items))
      (StaticArr items) (fmt "$[%s]" &(join-children items))
      (Dict items) (fmt "{%s}" &(join-children items))
      (Cmt s) (fmt ";%s
" s)))
  (implements str Form.str))

(defmodule Info
  (doc synthetic "is an `Info` for synthesized nodes (e.g. reader-macro
expansions like `&x` → `(ref x)`, where the `ref` symbol isn't in the
source). `pos`, `line`, and `col` are all `0`.")
  (defn synthetic [] (Info.init 0 0 0)))

(defmodule Located
  (doc str "renders a `Located` as source-like text via the underlying
`Form.str`. Position info is dropped — use `Located.info` directly if
you need it.")
  (defn str [l] (Form.str (Located.form l)))
  (implements str Located.str))

(doc ReaderCategory
  "is a reader-owned source category, independent of any display style.")
(deftype ReaderCategory
  (Whitespace [])
  (Symbol [])
  (Number [])
  (Boolean [])
  (String [])
  (Pattern [])
  (Character [])
  (Comment [])
  (Open [])
  (Close [])
  (Prefix [])
  (Unknown []))

(deftype ReaderGroup
  (List [])
  (Array [])
  (StaticArray [])
  (Dictionary []))

(doc ReaderNodeKind "preserves written syntax before reader-macro lowering.
Only Atom carries a compiler form. Missing nodes have zero width; Invalid
nodes retain the exact bytes rejected by the reader.")
(deftype ReaderNodeKind
  (Atom [Form])
  (Whitespace [])
  (Group [ReaderGroup])
  (ReaderMacro [String])
  (Punctuation [ReaderCategory])
  (Invalid [ReaderCategory])
  (Missing [String]))

(deftype ReaderNode
  [kind ReaderNodeKind
   start Info
   end Info
   children (Array (Box ReaderNode))])

(deftype ReaderIssueKind
  (Incomplete [])
  (Invalid []))
(deftype ReaderStatus
  (Complete [])
  (Incomplete [])
  (Invalid []))
(deftype ReaderIssue [kind ReaderIssueKind
                      start Info
                      end Info
                      error ParseErr])

(doc ReaderDocument "is a lossless read of one exact UTF-8 source buffer.
Its leaves partition the source, apart from zero-width missing nodes. Issues
do not discard syntax. Conversion to compiler forms requires no issues.")
(deftype ReaderDocument
  [source String
   nodes (Array (Box ReaderNode))
   issues (Array ReaderIssue)])

(deftype ReaderAtom (Parsed [ReaderCategory (Reply Form)]))

(deftype ReaderPrefix
  (Present [String Int])
  (Absent []))

; The grammar owns recognition and recovery; builders own representation.
; Leaf events carry no children array, so dropping trivia does not allocate.
(deftype (ReaderShape a)
  (Leaf [ReaderNodeKind])
  (Group [ReaderGroup (Array (Box a))])
  (Prefix [String Info (Maybe a)]))

(deftype (ReaderStep a) (Parsed [(Maybe a) Cursor]))
(deftype (ReaderOutput a) (Read [(Array (Box a)) (Array ReaderIssue)]))

(defmodule Reader
  (private ws-byte?)
  (hidden ws-byte?)
  (defn ws-byte? [c]
    (or (or (Char.= c \space) (Char.= c \tab))
        (or (or (Char.= c \newline) (Char.= c \return)) (Char.= c \,))))

  (private skip-ws)
  (hidden skip-ws)
  (defn skip-ws []
    (Parser.map (Parser.take-while (fn [c] (ws-byte? c))) (fn [_] ())))

  (private digit?)
  (hidden digit?)
  (defn digit? [c] (and (Char.>= c \0) (Char.<= c \9)))

  (private hex-digit?)
  (hidden hex-digit?)
  (defn hex-digit? [c]
    (or (digit? c)
        (or (and (Char.>= c \a) (Char.<= c \f))
            (and (Char.>= c \A) (Char.<= c \F)))))

  (private bin-digit?)
  (hidden bin-digit?)
  (defn bin-digit? [c] (or (Char.= c \0) (Char.= c \1)))

  (private octal-digit?)
  (hidden octal-digit?)
  (defn octal-digit? [c] (and (Char.>= c \0) (Char.<= c \7)))

  (private octal-digit-at?)
  (hidden octal-digit-at?)
  (defn octal-digit-at? [src len pos]
    (and (Int.< pos len) (octal-digit? (String.char-at src pos))))

  (private alpha?)
  (hidden alpha?)
  (defn alpha? [c]
    (or (and (Char.>= c \A) (Char.<= c \Z)) (and (Char.>= c \a) (Char.<= c \z))))

  (private sym-extra?)
  (hidden sym-extra?)
  (defn sym-extra? [c]
    (or
      (or (or (Char.= c \+) (Char.= c \-)) (or (Char.= c \*) (Char.= c \/)))
      (or
        (or (or (Char.= c \?) (Char.= c \!)) (or (Char.= c \>) (Char.= c \<)))
        (or (or (Char.= c \=) (Char.= c \_)) (Char.= c \:)))))

  (private high-ascii?)
  (hidden high-ascii?)
  (defn high-ascii? [c] (Int.> (Int.bit-and 255 (Char.to-int c)) 127))

  (private sym-byte?)
  (hidden sym-byte?)
  (defn sym-byte? [c]
    (or (or (alpha? c) (digit? c)) (or (sym-extra? c) (high-ascii? c))))

  (private hex-value)
  (hidden hex-value)
  (defn hex-value [c]
    (cond
      (and (Char.>= c \0) (Char.<= c \9))
        (Int.- (Char.to-int c) (Char.to-int \0))
      (and (Char.>= c \a) (Char.<= c \f))
        (Int.+ 10 (Int.- (Char.to-int c) (Char.to-int \a)))
      (and (Char.>= c \A) (Char.<= c \F))
        (Int.+ 10 (Int.- (Char.to-int c) (Char.to-int \A)))
      0))

  (private read-hex)
  (hidden read-hex)
  (defn read-hex [src pos count]
    (let-do [acc 0]
      (for [i 0 count]
        (set! acc
              (Int.+ (Int.* acc 16)
                     (hex-value (String.char-at src (Int.+ pos i))))))
      acc))

  (private hex-run?)
  (hidden hex-run?)
  (defn hex-run? [src len start n]
    (and (Int.<= (Int.+ start n) len)
         (let-do [ok true]
           (for [j start (Int.+ start n)]
             (unless (hex-digit? (String.char-at src j)) (set! ok false)))
           ok)))

  (private push-utf8-bytes)
  (hidden push-utf8-bytes)
  (defn push-utf8-bytes [bytes cp]
    (cond
      (Int.< cp 128) (Array.push-back bytes (Byte.from-int cp))
      (Int.< cp 2048)
        (let-do [out bytes]
          (set! out
                (Array.push-back out
                                 (Byte.from-int
                                   (Int.bit-or 192 (Int.bit-shift-right cp 6)))))
          (Array.push-back out
                           (Byte.from-int (Int.bit-or 128 (Int.bit-and cp 63)))))
      (Int.< cp 65536)
        (let-do [out bytes]
          (set! out
                (Array.push-back out
                                 (Byte.from-int
                                   (Int.bit-or 224 (Int.bit-shift-right cp 12)))))
          (set! out
                (Array.push-back out
                                 (Byte.from-int
                                   (Int.bit-or 128
                                               (Int.bit-and (Int.bit-shift-right cp
                                                                                 6)
                                                            63)))))
          (Array.push-back out
                           (Byte.from-int (Int.bit-or 128 (Int.bit-and cp 63)))))
      (let-do [out bytes]
        (set! out
              (Array.push-back out
                               (Byte.from-int
                                 (Int.bit-or 240 (Int.bit-shift-right cp 18)))))
        (set! out
              (Array.push-back out
                               (Byte.from-int
                                 (Int.bit-or 128
                                             (Int.bit-and (Int.bit-shift-right cp
                                                                               12)
                                                          63)))))
        (set! out
              (Array.push-back out
                               (Byte.from-int
                                 (Int.bit-or 128
                                             (Int.bit-and (Int.bit-shift-right cp
                                                                               6)
                                                          63)))))
        (Array.push-back out
                         (Byte.from-int (Int.bit-or 128 (Int.bit-and cp 63)))))))

  (private push-byte)
  (hidden push-byte)
  (defn push-byte [bytes c]
    (Array.push-back bytes (Byte.from-int (Int.bit-and 255 (Char.to-int c)))))

  (private parse-digits-from)
  (hidden parse-digits-from)
  (defn parse-digits-from [src digit-start digit-end base negate]
    (let-do [acc 0l
             b-long (Long.from-int base)]
      (for [i digit-start digit-end]
        (set! acc
              (Long.+ (Long.* acc b-long)
                      (Long.from-int (hex-value (String.char-at src i))))))
      (if negate (Long.neg acc) acc)))

  (private is-base-digit?)
  (hidden is-base-digit?)
  (defn is-base-digit? [c base]
    (cond
      (Int.= base 16) (hex-digit? c)
      (Int.= base 2) (bin-digit? c)
      (digit? c)))

  (private scan-exponent)
  (hidden scan-exponent)
  ; returns `pos` unchanged to signal that there is no exponent here.
  (defn scan-exponent [src len pos]
    (if (Int.>= pos len)
      pos
      (let [c0 (String.char-at src pos)]
        (if (not (or (Char.= c0 \e) (Char.= c0 \E)))
          pos
          (let-do [p (Int.inc pos)]
            (when (and (Int.< p len)
                       (let [c (String.char-at src p)]
                         (or (Char.= c \+) (Char.= c \-))))
              (set! p (Int.inc p)))
            (let-do [digits-start p]
              (while-do (and (Int.< p len) (digit? (String.char-at src p)))
                (set! p (Int.inc p)))
              (if (Int.> p digits-start) p pos)))))))

  (private number)
  (hidden number)
  (defn number []
    (Parser.init
      (fn [src len cur]
        (let-do [start @(Cursor.pos cur)
                 pos start
                 negate false]
          (when-do (and (Int.< pos len) (Char.= (String.char-at src pos) \-))
            (set! negate true)
            (set! pos (Int.inc pos)))
          (let-do [base 10
                   digit-start pos]
            (when (and (Int.<= (Int.+ pos 2) len)
                       (Char.= (String.char-at src pos) \0))
              (let [c1 (String.char-at src (Int.inc pos))]
                (cond
                  (Char.= c1 \x)
                    (do
                      (set! base 16)
                      (set! pos (Int.+ pos 2))
                      (set! digit-start pos))
                  (Char.= c1 \b)
                    (do
                      (set! base 2)
                      (set! pos (Int.+ pos 2))
                      (set! digit-start pos))
                  ())))
            (let-do [int-end pos]
              (while-do (and (Int.< int-end len)
                             (is-base-digit? (String.char-at src int-end) base))
                (set! int-end (Int.inc int-end)))
              (set! pos int-end)
              (if (Int.= pos digit-start)
                (Reply.ErrEmpty (ParseErr.expected-at cur @"number"))
                (let-do [int-value (parse-digits-from src
                                                      digit-start
                                                      int-end
                                                      base
                                                      negate)
                         next-c (if (Int.< pos len)
                           (String.char-at src pos)
                           \space)]
                  (cond
                    (Char.= next-c \.)
                      (let-do [frac-start (Int.inc pos)
                               frac-end frac-start]
                        (while-do (and (Int.< frac-end len)
                                       (digit? (String.char-at src frac-end)))
                          (set! frac-end (Int.inc frac-end)))
                        (if (Int.= frac-end frac-start)
                          (Reply.ErrConsumed
                            (ParseErr.expected-at cur @"fractional digits"))
                          (let-do [exp-end (scan-exponent src len frac-end)
                                   post exp-end
                                   is-float false]
                            (when-do (and (Int.< post len)
                                          (Char.= (String.char-at src post) \f))
                              (set! is-float true)
                              (set! post (Int.inc post)))
                            (let [num-text (String.byte-slice src start exp-end)]
                              (match (Double.from-string &num-text)
                                (Maybe.Just d)
                                  (Reply.OkConsumed
                                    (if is-float
                                      (Form.Flt (Double.to-float d))
                                      (Form.Dbl d))
                                    (Cursor.advance-string cur
                                                           src
                                                           start
                                                           (Int.- post start)))
                                (Maybe.Nothing)
                                  (Reply.ErrConsumed
                                    (ParseErr.expected-at cur
                                                          (if is-float
                                                            @"float"
                                                            @"double"))))))))
                    (or (Char.= next-c \e) (Char.= next-c \E))
                      (let-do [exp-end (scan-exponent src len pos)]
                        (if (Int.= exp-end pos)
                          (Reply.OkConsumed (Form.Itg (Long.to-int int-value))
                                            (Cursor.advance-string cur
                                                                   src
                                                                   start
                                                                   (Int.- pos
                                                                          start)))
                          (let-do [post exp-end
                                   is-float false]
                            (when-do (and (Int.< post len)
                                          (Char.= (String.char-at src post) \f))
                              (set! is-float true)
                              (set! post (Int.inc post)))
                            (let [num-text (String.byte-slice src start exp-end)]
                              (match (Double.from-string &num-text)
                                (Maybe.Just d)
                                  (Reply.OkConsumed
                                    (if is-float
                                      (Form.Flt (Double.to-float d))
                                      (Form.Dbl d))
                                    (Cursor.advance-string cur
                                                           src
                                                           start
                                                           (Int.- post start)))
                                (Maybe.Nothing)
                                  (Reply.ErrConsumed
                                    (ParseErr.expected-at cur
                                                          (if is-float
                                                            @"float"
                                                            @"double"))))))))
                    (Char.= next-c \b)
                      (Reply.OkConsumed
                        (Form.Byt (Byte.from-int (Long.to-int int-value)))
                        (Cursor.advance-string cur
                                               src
                                               start
                                               (Int.- (Int.inc pos) start)))
                    (Char.= next-c \l)
                      (Reply.OkConsumed (Form.Lng int-value)
                                        (Cursor.advance-string cur
                                                               src
                                                               start
                                                               (Int.- (Int.inc pos)
                                                                      start)))
                    (Char.= next-c \f)
                      (let [num-text (String.byte-slice src start pos)]
                        (match (Double.from-string &num-text)
                          (Maybe.Just d)
                            (Reply.OkConsumed (Form.Flt (Double.to-float d))
                                              (Cursor.advance-string cur
                                                                     src
                                                                     start
                                                                     (Int.- (Int.inc pos)
                                                                            start)))
                          (Maybe.Nothing)
                            (Reply.ErrConsumed (ParseErr.expected-at cur
                                                                     @"float"))))
                    (Reply.OkConsumed (Form.Itg (Long.to-int int-value))
                                      (Cursor.advance-string cur
                                                             src
                                                             start
                                                             (Int.- pos start))))))))))))

  (private string-)
  (hidden string-)
  (defn string- []
    (Parser.init
      (fn [src len cur]
        (let [start @(Cursor.pos cur)]
          (if (or (Int.>= start len)
                  (not (Char.= (String.char-at src start) \")))
            (Reply.ErrEmpty (ParseErr.expected-at cur @"string"))
            (let-do [c (Cursor.advance cur \")
                     bytes (the (Array Byte) [])
                     going true
                     err @""]
              (while-do (and going (Int.= 0 (String.length &err)))
                (if (Int.>= @(Cursor.pos &c) len)
                  (set! err @"closing quote")
                  (let [ch (String.char-at src @(Cursor.pos &c))]
                    (cond
                      (Char.= ch \")
                        (do (set! c (Cursor.advance &c ch)) (set! going false))
                      (Char.= ch \\)
                        (if (Int.>= (Int.+ @(Cursor.pos &c) 1) len)
                          (set! err @"closing quote")
                          (let [esc (String.char-at src
                                                    (Int.+ @(Cursor.pos &c) 1))]
                            (cond
                              (Char.= esc \n)
                              (do
                                (set! bytes (push-byte bytes \newline))
                                (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \t)
                              (do
                                (set! bytes (push-byte bytes \tab))
                                (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \r)
                              (do
                                (set! bytes (push-byte bytes \return))
                                (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \b)
                              (do
                                (set! bytes (push-byte bytes \backspace))
                                (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \f)
                              (do
                                (set! bytes (push-byte bytes \formfeed))
                                (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \v)
                              (do
                                (set! bytes
                                      (Array.push-back bytes (Byte.from-int 11)))
                                (set! c (Cursor.advance-by &c 2 false)))
                              (Char.= esc \a)
                              (do
                                (set! bytes
                                      (Array.push-back bytes (Byte.from-int 7)))
                                (set! c (Cursor.advance-by &c 2 false)))
                              (or (Char.= esc \\)
                                  (or (Char.= esc \") (Char.= esc \')))
                              (do
                                (set! bytes (push-byte bytes esc))
                                (set! c (Cursor.advance-by &c 2 false)))
                              (and (Char.= esc \x)
                                   (hex-run? src
                                             len
                                             (Int.+ @(Cursor.pos &c) 2)
                                             1))
                              ; C semantics: \x maps to one byte, so read at
                              ; most 2 hex digits (capping avoids silently
                              ; folding extra digits down to the low byte).
                              (let-do [digits-start (Int.+ @(Cursor.pos &c) 2)
                                       max-end (Int.min len
                                                        (Int.+ digits-start 2))
                                       end digits-start]
                                (while-do (and (Int.< end max-end)
                                               (hex-digit? (String.char-at src
                                                                           end)))
                                  (set! end (Int.inc end)))
                                (set! bytes
                                      (Array.push-back bytes
                                                       (Byte.from-int
                                                         (read-hex src
                                                                   digits-start
                                                                   (Int.- end
                                                                          digits-start)))))
                                (set! c
                                      (Cursor.advance-by &c
                                                         (Int.- end
                                                                @(Cursor.pos &c))
                                                         false)))
                              (and (Char.= esc \u)
                                   (hex-run? src
                                             len
                                             (Int.+ @(Cursor.pos &c) 2)
                                             4))
                              (let-do [hex-start (Int.+ @(Cursor.pos &c) 2)]
                                (set! bytes
                                      (push-utf8-bytes bytes
                                                       (read-hex src hex-start 4)))
                                (set! c (Cursor.advance-by &c 6 false)))
                              (and (Char.= esc \U)
                                   (hex-run? src
                                             len
                                             (Int.+ @(Cursor.pos &c) 2)
                                             8))
                              (let-do [hex-start (Int.+ @(Cursor.pos &c) 2)]
                                (set! bytes
                                      (push-utf8-bytes bytes
                                                       (read-hex src hex-start 8)))
                                (set! c (Cursor.advance-by &c 10 false)))
                              ;; a digit run after the backslash reads as one
                              ;; character code (the reference feeds octal-looking
                              ;; runs through its hex reader, quirk included) and
                              ;; needs at least two digits.
                              (and (octal-digit? esc)
                                   (octal-digit-at? src
                                                    len
                                                    (Int.+ @(Cursor.pos &c) 2)))
                              (let-do [digits-start (Int.inc @(Cursor.pos &c))
                                       end digits-start]
                                (while-do (and (Int.< end len)
                                               (octal-digit? (String.char-at src
                                                                             end)))
                                  (set! end (Int.inc end)))
                                (set! bytes
                                      (push-utf8-bytes bytes
                                                       (read-hex src
                                                                 digits-start
                                                                 (Int.- end
                                                                        digits-start))))
                                (set! c
                                      (Cursor.advance-by &c
                                                         (Int.- end
                                                                @(Cursor.pos &c))
                                                         false)))
                              ;; the reference passes any other escape through
                              ;; verbatim, backslash included.
                              (do
                                (set! bytes (push-byte bytes \\))
                                (set! bytes (push-byte bytes esc))
                                (set! c (Cursor.advance-by &c 2 false))))))
                      (do
                        (set! bytes (push-byte bytes ch))
                        (set! c (Cursor.advance &c ch)))))))
              (if (Int.> (String.length &err) 0)
                (Reply.ErrConsumed (ParseErr.expected-at &c err))
                (Reply.OkConsumed (Form.Str (String.from-bytes &bytes)) c))))))))

  (private raw-string)
  (hidden raw-string)
  (defn raw-string []
    (Parser.init
      (fn [src len cur]
        (let [start @(Cursor.pos cur)]
          (if (or (Int.>= (Int.+ start 1) len)
                  (or
                    (not (Char.= (String.char-at src start) \r))
                    (not (Char.= (String.char-at src (Int.+ start 1)) \"))))
            (Reply.ErrEmpty (ParseErr.expected-at cur @"raw string"))
            (let-do [c (Cursor.advance-by cur 2 false)
                     chars []
                     going true
                     err false]
              (while-do (and going (not err))
                (if (Int.>= @(Cursor.pos &c) len)
                  (set! err true)
                  (let [ch (String.char-at src @(Cursor.pos &c))]
                    (if (Char.= ch \")
                      (if (and (Int.< (Int.inc @(Cursor.pos &c)) len)
                               (Char.=
                                 (String.char-at src (Int.inc @(Cursor.pos &c)))
                                 \"))
                        (do
                          (set! chars (Array.push-back chars \"))
                          (set! c (Cursor.advance-by &c 2 false)))
                        (do (set! c (Cursor.advance &c ch)) (set! going false)))
                      (do
                        (set! chars (Array.push-back chars ch))
                        (set! c (Cursor.advance &c ch)))))))
              (if err
                (Reply.ErrConsumed (ParseErr.expected-at &c @"closing quote"))
                (Reply.OkConsumed (Form.Str (String.from-chars &chars)) c))))))))

  (private pattern-)
  (hidden pattern-)
  (defn pattern- []
    (Parser.init
      (fn [src len cur]
        (let [start @(Cursor.pos cur)]
          (if (or (Int.>= (Int.+ start 1) len)
                  (or
                    (not (Char.= (String.char-at src start) \#))
                    (not (Char.= (String.char-at src (Int.+ start 1)) \"))))
            (Reply.ErrEmpty (ParseErr.expected-at cur @"pattern"))
            (let-do [c (Cursor.advance-by cur 2 false)
                     chars []
                     going true
                     err false]
              (while-do (and going (not err))
                (if (Int.>= @(Cursor.pos &c) len)
                  (set! err true)
                  (let [ch (String.char-at src @(Cursor.pos &c))]
                    (if (Char.= ch \")
                      (do (set! c (Cursor.advance &c ch)) (set! going false))
                      (do
                        (set! chars (Array.push-back chars ch))
                        (set! c (Cursor.advance &c ch)))))))
              (if err
                (Reply.ErrConsumed (ParseErr.expected-at &c @"closing quote"))
                (Reply.OkConsumed (Form.Pat (String.from-chars &chars)) c))))))))

  (private named-char)
  (hidden named-char)
  (defn named-char [name]
    (cond
      (= &name "space") (Maybe.Just \space)
      (= &name "tab") (Maybe.Just \tab)
      (= &name "newline") (Maybe.Just \newline)
      (= &name "return") (Maybe.Just \return)
      (= &name "backspace") (Maybe.Just \backspace)
      (= &name "formfeed") (Maybe.Just \formfeed)
      (= &name "\"") (Maybe.Just \")
      (Maybe.Nothing)))

  (private unicode-char)
  (hidden unicode-char)
  (defn unicode-char []
    (Parser.bind (Parser.byte \u)
                 (fn [_]
                   (Parser.bind
                     (Parser.slice-of
                       (Parser.count 4
                                     (Parser.satisfy (fn [c] (hex-digit? c))
                                                     @"hex digit")))
                     (fn [hex]
                       (Parser.pure
                         (Form.Chr (Char.from-int (read-hex &hex 0 4)))))))))

  (private unicode-char-long)
  (hidden unicode-char-long)
  (defn unicode-char-long []
    (Parser.bind (Parser.byte \U)
                 (fn [_]
                   (Parser.bind
                     (Parser.slice-of
                       (Parser.count 8
                                     (Parser.satisfy (fn [c] (hex-digit? c))
                                                     @"hex digit")))
                     (fn [hex]
                       (Parser.pure
                         (Form.Chr (Char.from-int (read-hex &hex 0 8)))))))))

  (private char-)
  (hidden char-)
  (defn char- []
    (Parser.bind (Parser.byte \\)
                 (fn [_]
                   (Parser.choice
                     [(Parser.try (unicode-char-long))
                      (Parser.try (unicode-char))
                      (Parser.bind
                        (Parser.take-while1 (fn [c] (sym-byte? c)))
                        (fn [name]
                          ;; one CODEPOINT (not byte) is a plain char literal,
                          ;; so multibyte literals like \ä parse
                          (let [decoded (String.chars &name)]
                            (if (= 1 (Array.length &decoded))
                              (Parser.pure
                                (Form.Chr @(Array.unsafe-nth &decoded 0)))
                              (match (named-char @&name)
                                (Maybe.Just c) (Parser.pure (Form.Chr c))
                                (Maybe.Nothing) (Parser.fail @"named char"))))))
                      (Parser.map (Parser.any-byte) (fn [c] (Form.Chr c)))]))))

  (private segment)
  (hidden segment)
  (defn segment [] (Parser.take-while1 (fn [c] (sym-byte? c))))

  (private symbol-)
  (hidden symbol-)
  (defn symbol- []
    (Parser.map
      (Parser.label @"symbol" (Parser.sep-by1 (segment) (Parser.byte \.)))
      (fn [segments]
        (if (Int.= 1 (Array.length &segments))
          (let [only (Array.unsafe-nth &segments 0)]
            (cond
              (= only "true") (Form.Bol true)
              (= only "false") (Form.Bol false)
              (Form.Sym segments)))
          (Form.Sym segments)))))

  (private comment-)
  (hidden comment-)
  (defn comment- []
    (Parser.map
      (Parser.then (Parser.byte \;)
                   (Parser.take-while (fn [c] (not (Char.= c \newline)))))
      (fn [s] (Form.Cmt s)))))

(defmodule Reader
  (private info)
  (hidden info)
  (defn info [cursor]
    (Info.init @(Cursor.pos cursor) @(Cursor.line cursor) @(Cursor.col cursor)))

  (private leaf)
  (hidden leaf)
  (defn leaf [builder kind begin end]
    (~builder (ReaderShape.Leaf kind) (info begin) (info end)))

  (private append!)
  (hidden append!)
  (defn append! [children node]
    (match node
      (Maybe.Just value) (Array.push-back! children (Box.init value))
      (Maybe.Nothing) ()))

  (private group-form)
  (hidden group-form)
  (defn group-form [group children]
    (match group
      (ReaderGroup.List) (Form.Lst children)
      (ReaderGroup.Array) (Form.Arr children)
      (ReaderGroup.StaticArray) (Form.StaticArr children)
      (ReaderGroup.Dictionary) (Form.Dict children)))

  (private prefix-form)
  (hidden prefix-form)
  (defn prefix-form [name operand]
    (Form.Lst
      [(Box.init
         (Located.init (Form.Sym [name]) (Info.synthetic) (Info.synthetic)))
       (Box.init operand)]))

  (private build-form)
  (hidden build-form)
  (defn build-form [shape begin end]
    (let [value (match shape
            (ReaderShape.Leaf (ReaderNodeKind.Atom form)) (Maybe.Just form)
            (ReaderShape.Leaf _) (Maybe.Nothing)
            (ReaderShape.Group group children)
              (Maybe.Just (group-form group children))
            (ReaderShape.Prefix name _ operand)
              (match operand
                (Maybe.Just value) (Maybe.Just (prefix-form name value))
                (Maybe.Nothing) (Maybe.Nothing)))]
      (match value
        (Maybe.Just form) (Maybe.Just (Located.init form begin end))
        (Maybe.Nothing) (Maybe.Nothing))))

  (private build-syntax)
  (hidden build-syntax)
  (defn build-syntax [shape begin end]
    (match shape
      (ReaderShape.Leaf kind) (Maybe.Just (ReaderNode.init kind begin end []))
      (ReaderShape.Group group children)
        (Maybe.Just
          (ReaderNode.init (ReaderNodeKind.Group group) begin end children))
      (ReaderShape.Prefix name prefix-end operand)
        (let-do [prefix-children [(Box.init
                                    (ReaderNode.init
                                      (ReaderNodeKind.Punctuation (ReaderCategory.Prefix))
                                      @&begin
                                      prefix-end
                                      []))]]
          (append! &prefix-children operand)
          (Maybe.Just
            (ReaderNode.init (ReaderNodeKind.ReaderMacro name)
                             begin
                             end
                             prefix-children)))))

  (private category)
  (hidden category)
  (defn category [form]
    (match-ref form
      (Form.Sym _) (ReaderCategory.Symbol)
      (Form.Bol _) (ReaderCategory.Boolean)
      (Form.Str _) (ReaderCategory.String)
      (Form.Pat _) (ReaderCategory.Pattern)
      (Form.Chr _) (ReaderCategory.Character)
      (Form.Cmt _) (ReaderCategory.Comment)
      _ (ReaderCategory.Number)))

  (private issue!)
  (hidden issue!)
  (defn issue! [issues kind begin end error]
    (Array.push-back! issues
                      (ReaderIssue.init kind (info begin) (info end) error)))

  (private *string-cell*)
  (def *string-cell* (string-))
  (private *raw-string-cell*)
  (def *raw-string-cell* (raw-string))
  (private *pattern-cell*)
  (def *pattern-cell* (pattern-))
  (private *char-cell*)
  (def *char-cell* (char-))
  (private *number-cell*)
  (def *number-cell* (number))
  (private *symbol-cell*)
  (def *symbol-cell* (symbol-))
  (private *comment-cell*)
  (def *comment-cell* (comment-))

  (private atom)
  (hidden atom)
  (defn atom [source length cursor]
    (let [position @(Cursor.pos cursor)
          c (String.char-at source position)]
      (cond
        (Char.= c \;)
          (ReaderAtom.Parsed (ReaderCategory.Comment)
                             (~(Parser.run &*comment-cell*) source length cursor))
        (Char.= c \")
          (ReaderAtom.Parsed (ReaderCategory.String)
                             (~(Parser.run &*string-cell*) source length cursor))
        (Char.= c \#)
          (ReaderAtom.Parsed (ReaderCategory.Pattern)
                             (~(Parser.run &*pattern-cell*) source length cursor))
        (Char.= c \\)
          (ReaderAtom.Parsed (ReaderCategory.Character)
                             (~(Parser.run &*char-cell*) source length cursor))
        (and (Char.= c \r)
             (and (Int.< (Int.inc position) length)
                  (Char.= (String.char-at source (Int.inc position)) \")))
          (ReaderAtom.Parsed (ReaderCategory.String)
                             (~(Parser.run &*raw-string-cell*) source
                                                               length
                                                               cursor))
        (or (digit? c) (Char.= c \-))
          (match (~(Parser.run &*number-cell*) source length cursor)
            (Reply.ErrEmpty _)
              (ReaderAtom.Parsed (ReaderCategory.Symbol)
                                 (~(Parser.run &*symbol-cell*) source
                                                               length
                                                               cursor))
            reply (ReaderAtom.Parsed (ReaderCategory.Number) reply))
        (ReaderAtom.Parsed (ReaderCategory.Symbol)
                           (~(Parser.run &*symbol-cell*) source length cursor)))))

  (private prefix)
  (hidden prefix)
  (defn prefix [source length position]
    (let [c (String.char-at source position)]
      (cond
        (Char.= c \&) (ReaderPrefix.Present @"ref" 1)
        (Char.= c \~) (ReaderPrefix.Present @"deref" 1)
        (Char.= c \@) (ReaderPrefix.Present @"copy" 1)
        (Char.= c \') (ReaderPrefix.Present @"quote" 1)
        (Char.= c \`) (ReaderPrefix.Present @"quasiquote" 1)
        (Char.= c \%)
          (if (and (Int.< (Int.inc position) length)
                   (Char.= (String.char-at source (Int.inc position)) \@))
            (ReaderPrefix.Present @"unquote-splicing" 2)
            (ReaderPrefix.Present @"unquote" 1))
        (ReaderPrefix.Absent))))

  (private closing?)
  (hidden closing?)
  (defn closing? [c] (or (Char.= c \)) (or (Char.= c \]) (Char.= c \}))))

  (private opening?)
  (hidden opening?)
  (defn opening? [source length position]
    (let [c (String.char-at source position)]
      (or (Char.= c \()
          (or (Char.= c \[)
              (or (Char.= c \{)
                  (and (Char.= c \$)
                       (and (Int.< (Int.inc position) length)
                            (Char.=
                              (String.char-at source (Int.inc position))
                              \[))))))))

  (private read-node)
  (hidden read-node)
  (register read-node
    (Fn
      [(Ref (Fn [(ReaderShape a) Info Info] (Maybe a)))
       (Ref String)
       Int
       (Ref Cursor)
       (Ref (Array Char))
       (Ref (Array ReaderIssue))]
      (ReaderStep a)))

  (private missing)
  (hidden missing)
  (defn missing [builder issues cursor expected incomplete]
    (do
      (issue! issues
              (if incomplete
                (ReaderIssueKind.Incomplete)
                (ReaderIssueKind.Invalid))
              cursor
              cursor
              (ParseErr.expected-at cursor (String.copy expected)))
      (leaf builder
            (ReaderNodeKind.Missing (String.copy expected))
            cursor
            cursor)))

  (private read-group)
  (hidden read-group)
  (defn read-group [builder source length begin parents issues]
    (let-do [first (String.char-at source @(Cursor.pos begin))
             closing (cond (Char.= first \() \) (Char.= first \{) \} \])
             group (cond
               (Char.= first \() (ReaderGroup.List)
               (Char.= first \[) (ReaderGroup.Array)
               (Char.= first \{) (ReaderGroup.Dictionary)
               (ReaderGroup.StaticArray))
             count (if (Char.= first \$) 2 1)
             cursor (Cursor.advance-string begin
                                           source
                                           @(Cursor.pos begin)
                                           count)
             children []
             done false]
      (append! &children
               (leaf builder
                     (ReaderNodeKind.Punctuation (ReaderCategory.Open))
                     begin
                     &cursor))
      (Array.push-back! parents closing)
      (while-do (not done)
        (cond
          (Int.>= @(Cursor.pos &cursor) length)
            (do
              (append! &children
                       (missing builder issues &cursor &(Char.str closing) true))
              (set! done true))
          (Char.= (String.char-at source @(Cursor.pos &cursor)) closing)
            (let-do [end (Cursor.advance &cursor closing)]
              (append! &children
                       (leaf builder
                             (ReaderNodeKind.Punctuation (ReaderCategory.Close))
                             &cursor
                             &end))
              (set! cursor end)
              (set! done true))
          (and
            (closing? (String.char-at source @(Cursor.pos &cursor)))
            (Array.contains? parents
                             &(String.char-at source @(Cursor.pos &cursor))))
            (do
              (append! &children
                       (missing builder issues &cursor &(Char.str closing) false))
              (set! done true))
          (match (read-node builder source length &cursor parents issues)
            (ReaderStep.Parsed node next)
              (do (append! &children node) (set! cursor next)))))
      (ignore (Array.pop-back! parents))
      (ReaderStep.Parsed
        (~builder (ReaderShape.Group group children) (info begin) (info &cursor))
        cursor)))

  (private read-prefix)
  (hidden read-prefix)
  (defn read-prefix [builder source length begin parents issues name count]
    (let-do [cursor (Cursor.advance-string begin
                                           source
                                           @(Cursor.pos begin)
                                           count)
             prefix-end (info &cursor)
             operand (Maybe.Nothing)]
      (if (or (Int.>= @(Cursor.pos &cursor) length)
              (let [c (String.char-at source @(Cursor.pos &cursor))]
                (or (ws-byte? c) (closing? c))))
        (set! operand
              (missing builder
                       issues
                       &cursor
                       "a form"
                       (Int.>= @(Cursor.pos &cursor) length)))
        (match (read-node builder source length &cursor parents issues)
          (ReaderStep.Parsed node next)
            (do (set! operand node) (set! cursor next))))
      (ReaderStep.Parsed
        (~builder
          (ReaderShape.Prefix name prefix-end operand)
          (info begin)
          (info &cursor))
        cursor)))

  (private recover-atom)
  (hidden recover-atom)
  (defn recover-atom [builder source length begin issues category consumed error]
    (let-do [start @(Cursor.pos begin)
             literal (and consumed
                          (match-ref category
                            (ReaderCategory.String) true
                            (ReaderCategory.Pattern) true
                            _ false))
             character (match-ref category
               (ReaderCategory.Character) true
               _ false)
             end (if literal length (Int.inc start))]
      (unless literal
        (while-do (and (Int.< end length)
                       (let [c (String.char-at source end)]
                         (or (sym-byte? c) (Char.= c \.))))
          (set! end (Int.inc end))))
      (let-do [cursor (Cursor.advance-string begin
                                             source
                                             start
                                             (Int.- end start))]
        (issue! issues
                (if (or literal (and character (Int.= (Int.inc start) length)))
                  (ReaderIssueKind.Incomplete)
                  (ReaderIssueKind.Invalid))
                begin
                &cursor
                error)
        (ReaderStep.Parsed
          (leaf builder (ReaderNodeKind.Invalid @category) begin &cursor)
          cursor))))

  (defn read-node [builder source length begin parents issues]
    (let [position @(Cursor.pos begin)
          first (String.char-at source position)]
      (cond
        (ws-byte? first)
          (let-do [end position]
            (while-do (and (Int.< end length)
                           (ws-byte? (String.char-at source end)))
              (set! end (Int.inc end)))
            (let [cursor (Cursor.advance-string begin
                                                source
                                                position
                                                (Int.- end position))]
              (ReaderStep.Parsed
                (leaf builder (ReaderNodeKind.Whitespace) begin &cursor)
                cursor)))
        (opening? source length position)
          (read-group builder source length begin parents issues)
        (closing? first)
          (let-do [end (Cursor.advance begin first)]
            (issue! issues
                    (ReaderIssueKind.Invalid)
                    begin
                    &end
                    (ParseErr.expected-at begin @"a form"))
            (ReaderStep.Parsed
              (leaf builder
                    (ReaderNodeKind.Invalid (ReaderCategory.Close))
                    begin
                    &end)
              end))
        (match (prefix source length position)
          (ReaderPrefix.Present name count)
            (read-prefix builder source length begin parents issues name count)
          (ReaderPrefix.Absent)
            (match (atom source length begin)
              (ReaderAtom.Parsed category reply)
                (match reply
                  (Reply.OkConsumed value cursor)
                    (ReaderStep.Parsed
                      (leaf builder (ReaderNodeKind.Atom value) begin &cursor)
                      cursor)
                  (Reply.OkEmpty value cursor)
                    (ReaderStep.Parsed
                      (leaf builder (ReaderNodeKind.Atom value) begin &cursor)
                      cursor)
                  (Reply.ErrConsumed error)
                    (recover-atom builder
                                  source
                                  length
                                  begin
                                  issues
                                  &category
                                  true
                                  error)
                  (Reply.ErrEmpty error)
                    (recover-atom builder
                                  source
                                  length
                                  begin
                                  issues
                                  &category
                                  false
                                  error)))))))

  (private read-source)
  (hidden read-source)
  (defn read-source [builder source]
    (let-do [length (String.length source)
             cursor (Cursor.init 0 1 1)
             nodes []
             issues (the (Array ReaderIssue) [])
             parents (the (Array Char) [])]
      (while-do (Int.< @(Cursor.pos &cursor) length)
        (match (read-node builder source length &cursor &parents &issues)
          (ReaderStep.Parsed node next)
            (do (append! &nodes node) (set! cursor next))))
      (ReaderOutput.Read nodes issues)))

  (doc read-syntax "reads complete, incomplete, or invalid source without
 discarding source syntax or executing reader macros. Uses the same grammar
 and recovery as strict parsing, retaining every written token.")
  (defn read-syntax [source]
    (let [builder build-syntax]
      (match (read-source &builder source)
        (ReaderOutput.Read nodes issues)
          (ReaderDocument.init (String.copy source) nodes issues))))

  (private lower-node)
  (hidden lower-node)
  (register lower-node (Fn [(Ref ReaderNode)] (Maybe Located)))

  (private lower-nodes)
  (hidden lower-nodes)
  (defn lower-nodes [nodes]
    (let-do [forms (the (Array (Box Located)) [])]
      (for [i 0 (Array.length nodes)]
        (match (lower-node (Box.peek (Array.unsafe-nth nodes i)))
          (Maybe.Just located) (Array.push-back! &forms (Box.init located))
          (Maybe.Nothing) ()))
      forms))

  (defn lower-node [node]
    (let [kind (ReaderNode.kind node)
          children (ReaderNode.children node)
          value (match-ref kind
            (ReaderNodeKind.Atom form) (Maybe.Just (Form.copy form))
            (ReaderNodeKind.Group group)
              (Maybe.Just (group-form @group (lower-nodes children)))
            (ReaderNodeKind.ReaderMacro name)
              (match (lower-node (Box.peek (Array.unsafe-nth children 1)))
                (Maybe.Just operand)
                  (Maybe.Just (prefix-form (String.copy name) operand))
                (Maybe.Nothing) (Maybe.Nothing))
            _ (the (Maybe Form) (Maybe.Nothing)))]
      (match value
        (Maybe.Just form)
          (Maybe.Just
            (Located.init form @(ReaderNode.start node) @(ReaderNode.end node)))
        (Maybe.Nothing) (Maybe.Nothing))))

  (doc parse "strictly reads source into located compiler forms. Shares the
 grammar and recovery used for lossless documents, and rejects any issue.
 Comments are retained.")

  (defn parse [source]
    (let [builder build-form]
      (match (read-source &builder source)
        (ReaderOutput.Read nodes issues)
          (if (Array.empty? &issues)
            (Result.Success nodes)
            (Result.Error
              (ParseErr.copy (ReaderIssue.error (Array.unsafe-nth &issues 0))))))))

  (doc parse-form
    "strictly reads exactly one form, including surrounding whitespace.")
  (defn parse-form [source]
    (match (parse source)
      (Result.Error error) (Result.Error error)
      (Result.Success forms)
        (cond
          (Int.= (Array.length &forms) 1)
            (Result.Success @(Box.peek (Array.unsafe-nth &forms 0)))
          (Array.empty? &forms)
            (Result.Error
              (ParseErr.expected-at
                &(Cursor.advance-string &(Cursor.init 0 1 1)
                                        source
                                        0
                                        (String.length source))
                @"a form"))
          (let [next (Located.info (Box.peek (Array.unsafe-nth &forms 1)))]
            (Result.Error
              (ParseErr.expected-at
                &(Cursor.init @(Info.pos next)
                              @(Info.line next)
                              @(Info.col next))
                @"end of input")))))))

(defmodule Reader
  (doc node-category
    "returns a lexical fact for a written leaf, without choosing a color.")
  (defn node-category [node]
    (match-ref (ReaderNode.kind node)
      (ReaderNodeKind.Atom form) (category form)
      (ReaderNodeKind.Whitespace) (ReaderCategory.Whitespace)
      (ReaderNodeKind.Punctuation category) (ReaderCategory.copy category)
      (ReaderNodeKind.Invalid category) (ReaderCategory.copy category)
      _ (ReaderCategory.Unknown)))

  (doc forms "converts an already-read document to compiler forms. Missing or
invalid syntax is rejected; recovery never invents compilable source.")
  (defn forms [document]
    (if (Array.empty? (ReaderDocument.issues document))
      (Result.Success (lower-nodes (ReaderDocument.nodes document)))
      (Result.Error
        (ParseErr.copy
          (ReaderIssue.error
            (Array.unsafe-nth (ReaderDocument.issues document) 0)))))))

(defmodule ReaderDocument
  (doc status "distinguishes valid input, input needing another form or closing
delimiter, and invalid input. A definite error takes precedence over missing syntax.")
  (defn status [document]
    (let-do [incomplete false
             invalid false
             issues (ReaderDocument.issues document)]
      (for [i 0 (Array.length issues)]
        (match-ref (ReaderIssue.kind (Array.unsafe-nth issues i))
          (ReaderIssueKind.Incomplete) (set! incomplete true)
          (ReaderIssueKind.Invalid) (set! invalid true)))
      (cond
        invalid (ReaderStatus.Invalid)
        incomplete (ReaderStatus.Incomplete)
        (ReaderStatus.Complete)))))
